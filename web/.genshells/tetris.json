{"label":"tetris","name":"tetris","exe":"TETRIS.EXE","sha256":"a4de367e8dcae39ea116de54580b1c33f8a7a2b82654ef925fd3c7abbe584051","bytes":19427,"model":"openai/gpt-5","createdAt":1790451767600,"installedBy":"0xbb15e7ecb1555ada5a687d7bd774cc34975f3450f22edecaed4b493440f74c94","published":true,"html":"<style>\n:root{\n  --face:#c0c0c0; --dark:#808080; --light:#ffffff; --shadow:#000000; --title:#000080; --titleText:#fff;\n}\n*{box-sizing:border-box}\n#app{position:fixed; inset:0; background:var(--face); display:grid; grid-template-rows:26px 1fr 24px; grid-template-columns:1fr 220px; gap:6px; padding:6px; font-family:Tahoma,Arial,Helvetica,sans-serif; color:#000}\n.titlebar{grid-column:1/3; background:linear-gradient(#000080,#0000a0); color:var(--titleText); display:flex; align-items:center; padding:2px 6px; font-weight:bold}\n.titlebar .small{opacity:.9; font-weight:normal; margin-left:8px}\n.panel{background:var(--face)}\n.sunken{border:2px inset var(--dark)}\n.raised{border:2px outset var(--light)}\n#gameWrap{position:relative; background:#9e9e9e}\n#hud{position:absolute; left:6px; top:6px; right:6px; display:flex; justify-content:space-between; gap:6px; pointer-events:none}\n.badge{background:var(--face); border:2px inset var(--dark); padding:2px 6px; font-size:12px; white-space:nowrap; max-width:60%; overflow:hidden; text-overflow:ellipsis}\n#canvas{width:100%; height:100%; image-rendering:pixelated; background:#9db1c8}\n.side{display:flex; flex-direction:column; gap:6px}\n.box{padding:6px; font-size:12px}\n.list{max-height:calc(100% - 60px); overflow:auto}\n.row{display:flex; justify-content:space-between; gap:6px; padding:2px 0}\n.row .name{overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:110px}\n.row .val{font-family:monospace}\n.up{color:#006400}\n.down{color:#8b0000}\n.controls{grid-column:1/3; display:flex; align-items:center; justify-content:space-between; padding:2px 6px; font-size:12px; background:var(--face)}\n.btn{padding:2px 8px; border:2px outset var(--light); background:var(--face); cursor:pointer; font-size:12px}\n.btn:active{border:2px inset var(--dark)}\n.mono{font-family:monospace}\n.smallmuted{opacity:.8}\nhr{border:0; border-top:1px solid var(--dark); margin:6px 0}\n.kb{font-family:monospace; background:#eee; border:1px solid #999; padding:0 3px}\n#nextBox{height:80px}\n</style>\n\n<div id=\"app\" class=\"raised\">\n  <div class=\"titlebar title\" id=\"titleBar\">TETRIS — <span id=\"barTitle\">Loading…</span> <span class=\"small\" id=\"barSub\"></span></div>\n\n  <div id=\"gameWrap\" class=\"sunken\">\n    <canvas id=\"canvas\"></canvas>\n    <div id=\"hud\">\n      <div class=\"badge\" id=\"hudLeft\">—</div>\n      <div class=\"badge mono\" id=\"hudRight\">—</div>\n    </div>\n  </div>\n\n  <div class=\"side\">\n    <div class=\"box raised\">\n      <div><b>Portfolio blocks</b></div>\n      <div id=\"nextBox\" class=\"sunken\" style=\"margin-top:4px; display:flex; align-items:center; justify-content:center; position:relative;\">\n        <canvas id=\"nextCanvas\" width=\"100\" height=\"70\" style=\"image-rendering:pixelated;\"></canvas>\n        <div id=\"nextLabel\" class=\"smallmuted\" style=\"position:absolute; bottom:2px; left:4px; right:4px; font-size:11px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;\"></div>\n      </div>\n    </div>\n    <div class=\"box raised\">\n      <div style=\"display:flex; justify-content:space-between; align-items:center;\">\n        <b>Assets</b>\n        <span class=\"smallmuted\" id=\"assetTotal\">—</span>\n      </div>\n      <div class=\"list\" id=\"assetList\"></div>\n    </div>\n    <div class=\"box raised\" id=\"actionsBox\" style=\"display:none;\">\n      <b>Actions</b>\n      <div id=\"actions\"></div>\n    </div>\n  </div>\n\n  <div class=\"controls raised\">\n    <div>\n      Controls:\n      <span class=\"kb\">←</span><span class=\"kb\">→</span> move\n      <span class=\"kb\">↑</span> rotate\n      <span class=\"kb\">↓</span> soft drop\n      <span class=\"kb\">Space</span> hard drop\n      <span class=\"kb\">P</span> pause\n      <span class=\"kb\">N</span> new\n    </div>\n    <div class=\"smallmuted mono\" id=\"status\">—</div>\n  </div>\n</div>\n\n<script>\n(function(){\n  const C={cols:10, rows:20};\n  const SHAPES=[\n    [[1,1,1,1]],               // I\n    [[1,1],[1,1]],             // O\n    [[1,1,1],[0,1,0]],         // T\n    [[0,1,1],[1,1,0]],         // S\n    [[1,1,0],[0,1,1]],         // Z\n    [[1,0,0],[1,1,1]],         // J\n    [[0,0,1],[1,1,1]]          // L\n  ];\n  const canvas=document.getElementById('canvas');\n  const ctx=canvas.getContext('2d');\n  const nextCanvas=document.getElementById('nextCanvas');\n  const nctx=nextCanvas.getContext('2d');\n\n  const els={\n    barTitle:document.getElementById('barTitle'),\n    barSub:document.getElementById('barSub'),\n    hudLeft:document.getElementById('hudLeft'),\n    hudRight:document.getElementById('hudRight'),\n    assetList:document.getElementById('assetList'),\n    assetTotal:document.getElementById('assetTotal'),\n    nextLabel:document.getElementById('nextLabel'),\n    status:document.getElementById('status'),\n    actions:document.getElementById('actions'),\n    actionsBox:document.getElementById('actionsBox'),\n  };\n\n  let DATA=null, APP=null, READY=false;\n\n  // Game state\n  const G={\n    grid:[], w:C.cols, h:C.rows, cell:20, pad:6,\n    cur:null, next:null, tick:0, step:700, last:0, running:true, over:false,\n    lines:0, score:0, effects:[], assets:[], totalUSD:0, preview:false\n  };\n\n  function hashColor(s){\n    let h=0; for(let i=0;i<s.length;i++) h=(h*31 + s.charCodeAt(i))>>>0;\n    const r=128+ (h&127), g=128+((h>>7)&127), b=128+((h>>14)&127);\n    return `rgb(${r},${g},${b})`;\n  }\n  function darken(rgb, f){\n    const m=rgb.match(/\\d+/g)||[180,180,180];\n    return `rgb(${(m[0]*f)|0},${(m[1]*f)|0},${(m[2]*f)|0})`;\n  }\n\n  function resetGrid(){\n    G.grid=new Array(G.h).fill(0).map(()=>new Array(G.w).fill(null));\n  }\n\n  function rot(mat, dir){\n    const H=mat.length, W=mat[0].length;\n    const out=new Array(W).fill(0).map(()=>new Array(H).fill(0));\n    for(let y=0;y<H;y++) for(let x=0;x<W;x++){\n      if(dir>0) out[x][H-1-y]=mat[y][x]; else out[W-1-x][y]=mat[y][x];\n    }\n    return out;\n  }\n\n  function collide(px,py,mat){\n    for(let y=0;y<mat.length;y++){\n      for(let x=0;x<mat[0].length;x++){\n        if(!mat[y][x]) continue;\n        const gx=px+x, gy=py+y;\n        if(gx<0||gx>=G.w||gy>=G.h) return true;\n        if(gy>=0 && G.grid[gy][gx]) return true;\n      }\n    }\n    return false;\n  }\n\n  function mergePiece(){\n    const {x,y,mat,asset,color}=G.cur;\n    for(let j=0;j<mat.length;j++) for(let i=0;i<mat[0].length;i++){\n      if(!mat[j][i]) continue;\n      const gx=x+i, gy=y+j;\n      if(gy>=0 && gy<G.h) G.grid[gy][gx]={asset,color};\n    }\n  }\n\n  function clearLines(){\n    let cleared=0;\n    for(let y=G.h-1;y>=0;y--){\n      if(G.grid[y].every(c=>c)){\n        G.grid.splice(y,1);\n        G.grid.unshift(new Array(G.w).fill(null));\n        cleared++; y++;\n      }\n    }\n    if(cleared){\n      G.lines+=cleared;\n      G.score+= [0,40,100,300,1200][cleared] || (cleared*300);\n      const top = G.assets[0];\n      const msg = `${cleared} line${cleared>1?'s':''}! ${top?top.label:''} ${top&&top.v?fmtUSD(top.v):''}`;\n      G.effects.push({x: G.w/2, y: 2, t: msg, ttl:60});\n    }\n  }\n\n  function weightedPick(){\n    const total=G.assets.reduce((a,o)=>a+o.w,0)||1;\n    let r=Math.random()*total, idx=0;\n    for(let i=0;i<G.assets.length;i++){ r-=G.assets[i].w; if(r<=0){ idx=i; break; } }\n    return G.assets[idx?idx:0] || {label:'N/A',v:0,w:1,color:'#bbb',tone:null};\n  }\n\n  function makePiece(next=false){\n    const mat=SHAPES[(Math.random()*SHAPES.length)|0].map(r=>r.slice());\n    const asset=weightedPick();\n    const color=hashColor(asset.label);\n    return {x: (G.w>>1)-((mat[0].length>>1)|0), y:-2, mat, asset, color};\n  }\n\n  function spawn(){\n    G.cur = G.next || makePiece();\n    G.cur.x=(G.w>>1)-((G.cur.mat[0].length>>1)|0);\n    G.cur.y=-2;\n    G.next = makePiece(true);\n    if(collide(G.cur.x, G.cur.y, G.cur.mat)){ G.over=true; G.running=false; status(`Game Over — Lines ${G.lines}`); }\n    updateNextPreview();\n  }\n\n  function move(dx,dy){\n    if(!G.cur) return;\n    const nx=G.cur.x+dx, ny=G.cur.y+dy;\n    if(!collide(nx,ny,G.cur.mat)){ G.cur.x=nx; G.cur.y=ny; return true; }\n    return false;\n  }\n\n  function rotate(dir){\n    const m=rot(G.cur.mat,dir);\n    if(!collide(G.cur.x,G.cur.y,m)){ G.cur.mat=m; return; }\n    // simple wall kicks\n    if(!collide(G.cur.x+1,G.cur.y,m)){ G.cur.x++; G.cur.mat=m; return; }\n    if(!collide(G.cur.x-1,G.cur.y,m)){ G.cur.x--; G.cur.mat=m; return; }\n  }\n\n  function hardDrop(){\n    if(!G.cur) return;\n    while(move(0,1)){}\n    tickDown(true);\n  }\n\n  function tickDown(lockNow){\n    if(!G.cur) return;\n    if(!move(0,1) || lockNow){\n      // lock\n      mergePiece();\n      clearLines();\n      spawn();\n    }\n  }\n\n  function drawCell(x,y,color){\n    const s=G.cell, px=G.pad+x*s, py=G.pad+y*s;\n    // bevel look\n    ctx.fillStyle=color; ctx.fillRect(px,py,s,s);\n    ctx.fillStyle=darken(color,1.25); ctx.fillRect(px,py,s,2); ctx.fillRect(px,py,2,s);\n    ctx.fillStyle=darken(color,0.6); ctx.fillRect(px,py+s-2,s,2); ctx.fillRect(px+s-2,py,2,s);\n  }\n\n  function draw(){\n    resizeCanvas();\n    ctx.clearRect(0,0,canvas.width,canvas.height);\n    // board bg\n    ctx.fillStyle='#708090'; ctx.fillRect(G.pad,G.pad,G.w*G.cell,G.h*G.cell);\n    // grid cells\n    for(let y=0;y<G.h;y++){\n      for(let x=0;x<G.w;x++){\n        const c=G.grid[y][x];\n        if(c) drawCell(x,y,c.color);\n      }\n    }\n    // current\n    if(G.cur){\n      const {x,y,mat,color,asset}=G.cur;\n      for(let j=0;j<mat.length;j++){\n        for(let i=0;i<mat[0].length;i++){\n          if(!mat[j][i]) continue;\n          const gy=y+j; if(gy<0) continue;\n          drawCell(x+i, gy, color);\n        }\n      }\n      // label overlay\n      drawPieceLabel(G.cur);\n    }\n    // effects\n    G.effects = G.effects.filter(e=>e.ttl-->0);\n    ctx.fillStyle='rgba(0,0,0,0.5)';\n    ctx.font=`${Math.max(10, (G.cell|0))}px monospace`;\n    ctx.textAlign='center';\n    ctx.textBaseline='top';\n    G.effects.forEach(e=>{\n      ctx.fillStyle='rgba(0,0,0,0.3)';\n      ctx.fillRect(G.pad+2, G.pad+2, G.w*G.cell-4, 20);\n      ctx.fillStyle='#fff';\n      ctx.fillText(e.t, G.pad + G.w*G.cell/2, G.pad+4);\n    });\n\n    // HUD\n    els.hudLeft.textContent = (DATA?.title||'') + (DATA?.table?.total?.pnl!=null ? ` · PnL ${fmtUSD(DATA.table.total.pnl)}` : '');\n    els.hudRight.textContent = `Lines ${G.lines}  Score ${G.score}`;\n  }\n\n  function drawPieceLabel(p){\n    // compute bounding box in pixels\n    let minx=999, maxx=-999, miny=999, maxy=-999;\n    for(let j=0;j<p.mat.length;j++)for(let i=0;i<p.mat[0].length;i++){\n      if(!p.mat[j][i]) continue;\n      const gx=p.x+i, gy=p.y+j;\n      if(gy<0) continue;\n      minx=Math.min(minx,gx); maxx=Math.max(maxx,gx);\n      miny=Math.min(miny,gy); maxy=Math.max(maxy,gy);\n    }\n    if(maxx<0||maxy<0) return;\n    const x=G.pad+minx*G.cell, y=G.pad+miny*G.cell, w=(maxx-minx+1)*G.cell, h=(maxy-miny+1)*G.cell;\n    const txt = `${p.asset.label} ${p.asset.v?fmtUSD(p.asset.v):''}`;\n    ctx.fillStyle='rgba(255,255,255,0.8)';\n    ctx.fillRect(x+1,y+1, w-2, 14);\n    ctx.strokeStyle='#000'; ctx.strokeRect(x+1,y+1, w-2, 14);\n    ctx.fillStyle='#000';\n    ctx.font='11px Tahoma, sans-serif';\n    ctx.textAlign='left'; ctx.textBaseline='top';\n    ctx.fillText(trunc(txt, Math.floor(w/7)), x+4, y+2);\n  }\n\n  function resizeCanvas(){\n    const wrap=document.getElementById('gameWrap');\n    const w=wrap.clientWidth, h=wrap.clientHeight;\n    canvas.width = w; canvas.height = h;\n    // cell size fits\n    const cw = Math.floor((w- G.pad*2) / G.w);\n    const ch = Math.floor((h- G.pad*2) / G.h);\n    G.cell = Math.max(8, Math.min(32, Math.min(cw, ch)));\n  }\n\n  function updateNextPreview(){\n    nctx.clearRect(0,0,nextCanvas.width,nextCanvas.height);\n    if(!G.next){ els.nextLabel.textContent=''; return; }\n    const m=G.next.mat, color=G.next.color;\n    const cell=12;\n    const w=m[0].length*cell, h=m.length*cell;\n    const ox=(nextCanvas.width - w)>>1, oy=(nextCanvas.height - h)>>1;\n    for(let j=0;j<m.length;j++)for(let i=0;i<m[0].length;i++){\n      if(!m[j][i]) continue;\n      // mini cell\n      nctx.fillStyle=color; nctx.fillRect(ox+i*cell, oy+j*cell, cell, cell);\n      nctx.fillStyle=darken(color,1.25); nctx.fillRect(ox+i*cell, oy+j*cell, cell, 2);\n      nctx.fillRect(ox+i*cell, oy+j*cell, 2, cell);\n      nctx.fillStyle=darken(color,0.6); nctx.fillRect(ox+i*cell, oy+j*cell+cell-2, cell, 2);\n      nctx.fillRect(ox+i*cell+cell-2, oy+j*cell, 2, cell);\n    }\n    const al=G.next.asset;\n    const extra = al && al.v ? ` ${fmtUSD(al.v)}` : '';\n    els.nextLabel.textContent = (al?al.label:'') + extra;\n  }\n\n  function gameLoop(ts){\n    if(!G.running){ draw(); requestAnimationFrame(gameLoop); return; }\n    if(!G.preview){\n      if(ts - G.last > G.step){ G.last=ts; tickDown(); }\n    }else{\n      // attract mode: gentle auto-play\n      if(ts - G.last > G.step){ G.last=ts; if(Math.random()<0.6) move((Math.random()<0.5?-1:1),0); if(Math.random()<0.3) rotate(1); tickDown(); }\n    }\n    draw();\n    requestAnimationFrame(gameLoop);\n  }\n\n  function status(t){ els.status.textContent=t; }\n\n  // Input\n  window.addEventListener('keydown', (e)=>{\n    if(G.preview) return;\n    if(G.over && e.key.toLowerCase()!=='n') return;\n    if(e.repeat) return;\n    if(e.key==='ArrowLeft'){ move(-1,0); e.preventDefault(); }\n    else if(e.key==='ArrowRight'){ move(1,0); e.preventDefault(); }\n    else if(e.key==='ArrowDown'){ move(0,1); e.preventDefault(); }\n    else if(e.key==='ArrowUp'){ rotate(1); e.preventDefault(); }\n    else if(e.code==='Space'){ hardDrop(); e.preventDefault(); }\n    else if(e.key==='p' || e.key==='P'){ G.running=!G.running; status(G.running?'Running':'Paused'); e.preventDefault(); }\n    else if(e.key==='n' || e.key==='N'){ newGame(); e.preventDefault(); }\n  });\n\n  function newGame(){\n    G.lines=0; G.score=0; G.effects.length=0; G.over=false; G.running=true; resetGrid(); G.cur=null; G.next=null; spawn(); status('New Game');\n  }\n\n  // Data parsing\n  function fmtUSD(n){ return suica.fmt.usd(Number(n)||0); }\n  function fmtPct(n){ return suica.fmt.pct(Number(n)||0); }\n  function trunc(s,len){ if(!s) return ''; s=String(s); return s.length>len? s.slice(0,Math.max(0,len-1))+'…' : s; }\n\n  function extractFromTable(tb){\n    if(!tb || !tb.columns || !tb.rows) return null;\n    const cols=tb.columns;\n    const textCol = cols.find(c=>c.fmt==='text')?.key || cols[0]?.key;\n    const usdCols = cols.filter(c=>c.fmt==='usd').map(c=>c.key);\n    const valueKey = cols.find(c=>c.key==='value')?.key || usdCols[0];\n    const changeKey = cols.find(c=>c.fmt==='pct' && (c.key==='change' || c.key==='24h' || true))?.key;\n    const pnlKey = cols.find(c=>c.key==='pnl' && c.fmt==='usd')?.key;\n\n    let totalUSD = (tb.total && valueKey && tb.total[valueKey]!=null)? Number(tb.total[valueKey]) : 0;\n    const rows = tb.rows.map(r=>{\n      const label = String(r[textCol] ?? '');\n      const v = valueKey? Number(r[valueKey] ?? 0) : 0;\n      const ch = changeKey!=null? Number(r[changeKey] ?? 0) : null;\n      const pnl= pnlKey!=null? Number(r[pnlKey] ?? 0) : null;\n      return {label, v, change: ch, pnl};\n    }).filter(r=>r.label);\n    if(!totalUSD){\n      totalUSD = rows.reduce((a,o)=>a+(o.v||0),0);\n    }\n    return {rows, totalUSD};\n  }\n\n  function extractFromList(li){\n    if(!li || !li.items) return null;\n    const rows = li.items.map(it=>{\n      const label = it.title || '';\n      // parse right like \"$3,017.38\"\n      let v=0;\n      if(it.right){ const num = String(it.right).replace(/[^0-9.\\-]/g,''); v=Number(num)||0; }\n      return {label, v, change: null, pnl:null, tone: it.tone||null};\n    }).filter(r=>r.label);\n    const totalUSD = rows.reduce((a,o)=>a+(o.v||0),0);\n    return {rows, totalUSD};\n  }\n\n  function extractAssets(bundle){\n    let rows=[], totalUSD=0;\n    const fromTable = extractFromTable(bundle.table);\n    if(fromTable){ rows=fromTable.rows; totalUSD=fromTable.totalUSD; }\n    else{\n      const fromList = extractFromList(bundle.list);\n      if(fromList){ rows=fromList.rows; totalUSD=fromList.totalUSD; }\n      else if(bundle.gauge){\n        rows=[{label:bundle.gauge.label, v:bundle.gauge.value||0, change:null, pnl:null}];\n        totalUSD=rows[0].v||0;\n      }else if(bundle.series){\n        const last=Array.isArray(bundle.series.points)? bundle.series.points[bundle.series.points.length-1]:0;\n        rows=[{label:bundle.series.label, v:Number(last)||0, change:null, pnl:null}];\n        totalUSD=rows[0].v||0;\n      }else{\n        rows=[{label:bundle.title||'Asset', v:1, change:null, pnl:null}];\n        totalUSD=1;\n      }\n    }\n    // sort by value desc\n    rows.sort((a,b)=>(b.v||0)-(a.v||0));\n    // weights\n    const t = totalUSD>0? totalUSD : rows.length;\n    const assets = rows.map(r=>{\n      const w = t? (r.v||0)/t : 1/rows.length;\n      const tone = r.change!=null ? (r.change<0?'down': (r.change>0?'up':null)) : (r.pnl!=null ? (r.pnl<0?'down': (r.pnl>0?'up':null)) : null);\n      return {label:r.label, v:r.v, w: Math.max(w, 0.0001), tone, color:hashColor(r.label), change:r.change, pnl:r.pnl};\n    });\n    return {assets, totalUSD};\n  }\n\n  function renderAssetList(){\n    const list=els.assetList;\n    list.innerHTML='';\n    if(!G.assets.length){ list.textContent='No assets'; return; }\n    G.assets.slice(0,8).forEach(a=>{\n      const row=document.createElement('div'); row.className='row';\n      const name=document.createElement('div'); name.className='name'; name.textContent=a.label;\n      const right=document.createElement('div'); right.className='val';\n      const parts=[];\n      if(a.v!=null) parts.push(fmtUSD(a.v));\n      if(a.change!=null) parts.push((a.change<0? '':'+') + fmtPct(a.change));\n      if(a.pnl!=null) parts.push((a.pnl<0? '':'+') + fmtUSD(a.pnl));\n      right.textContent=parts.join('  ');\n      if(a.tone==='up') right.classList.add('up'); else if(a.tone==='down') right.classList.add('down');\n      row.appendChild(name); row.appendChild(right);\n      list.appendChild(row);\n    });\n    els.assetTotal.textContent = `Total: ${fmtUSD(G.totalUSD)}`;\n  }\n\n  function renderActions(){\n    els.actions.innerHTML='';\n    els.actionsBox.style.display='none';\n    if(!DATA || !DATA.actions || !DATA.actions.length) return;\n    els.actionsBox.style.display='block';\n    DATA.actions.forEach((a,i)=>{\n      const b=document.createElement('button'); b.className='btn'; b.textContent=a.label || ('Action '+(i+1));\n      if(a.primary) b.style.fontWeight='bold';\n      b.addEventListener('click', ()=>{ suica.propose(a.id); });\n      els.actions.appendChild(b);\n    });\n  }\n\n  function updateHUD(){\n    els.barTitle.textContent = DATA?.title || (APP?.title || '—');\n    els.barSub.textContent = DATA?.subtitle ? `— ${DATA.subtitle}` : '';\n    els.hudLeft.textContent = `${DATA?.title||''}`;\n    els.hudRight.textContent = `Total ${fmtUSD(G.totalUSD)} · Lines ${G.lines}`;\n  }\n\n  function applyData(bundle, app){\n    DATA=bundle||{}; APP=app||{};\n    const {assets,totalUSD}=extractAssets(DATA);\n    // keep existing progress\n    G.assets = assets.length? assets : [{label:'N/A', v:0, w:1, color:'#bbb'}];\n    G.totalUSD = totalUSD||0;\n    G.preview = !!app.preview;\n    renderAssetList();\n    renderActions();\n    updateHUD();\n    if(!G.cur){ resetGrid(); spawn(); }\n    if(!READY){ draw(); suica.ready(); READY=true; }\n  }\n\n  suica.onData(({bundle, app})=>{\n    applyData(bundle, app);\n  });\n\n  // initial layout and start loop\n  window.addEventListener('resize', draw);\n  resetGrid(); spawn(); draw(); requestAnimationFrame(gameLoop);\n\n  // Show ready in case data lags; will call again after real data\n  setTimeout(()=>{ if(!READY){ draw(); try{ suica.ready(); READY=true; }catch(e){} } }, 1500);\n})();\n</script>","blobId":"ksFmd_cTqLanaBV_dEKoHYzNFk4Gvw6KN_RsjXy9_vo","ens":"tetris.shells.suica.eth"}