{"label":"paint-app","name":"paint app","exe":"PAINTAPP.EXE","sha256":"57911214de82b768822c8aa9b427a04264eecccffa20bd824c6b3804b8f636c9","bytes":26850,"model":"openai/gpt-5","createdAt":1790432741387,"installedBy":"guest","published":true,"html":"<style>\n  :root {\n    --face: #c0c0c0;\n    --dark: #808080;\n    --light: #ffffff;\n    --shadow: #000000;\n    --navy: #000080;\n  }\n  * { box-sizing: border-box; user-select: none; }\n  html, body, #root { width: 100vw; height: 100vh; margin: 0; overflow: hidden; background: #008080; font-family: Tahoma, Verdana, sans-serif; }\n  #win { position: absolute; inset: 0; display: flex; flex-direction: column; background: var(--face); }\n  .titlebar { height: 24px; background: linear-gradient(#000080, #1084d0); color: #fff; display: flex; align-items: center; padding: 0 8px; font-weight: bold; justify-content: space-between; }\n  .titlebar .tleft { display:flex; gap:8px; align-items:center; }\n  .titlebar .ticon { width: 14px; height: 14px; background: #fff; border: 1px solid #000; box-shadow: inset 1px 1px #808080; }\n  .titlebar .ttxt { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 60vw; }\n  .toolbar { display: flex; gap: 6px; padding: 6px; background: var(--face); border-bottom: 2px solid var(--dark); }\n  .raised { border: 2px solid #fff; border-bottom-color: #404040; border-right-color: #404040; background: var(--face); }\n  .sunken { border: 2px solid #404040; border-bottom-color: #fff; border-right-color: #fff; background: #fff; }\n  .btn { padding: 2px 6px; background: var(--face); border: 2px solid #fff; border-bottom-color: #404040; border-right-color: #404040; cursor: pointer; font-size: 12px; }\n  .btn:active, .btn.active { border: 2px solid #404040; border-bottom-color: #fff; border-right-color: #fff; background: #d4d0c8; }\n  .panel { display:flex; gap:10px; align-items:center; }\n  .sep { width: 2px; background: #808080; margin: 0 6px; align-self: stretch; }\n  #content { flex: 1; display: grid; grid-template-columns: 220px 1fr 220px; gap: 6px; padding: 6px; }\n  #left, #right { display: flex; flex-direction: column; gap: 6px; min-width: 0; }\n  .box { padding: 6px; }\n  #palette { display: grid; grid-template-columns: repeat(8, 1fr); gap: 4px; }\n  .sw { width: 20px; height: 16px; border: 1px solid #000; cursor: pointer; }\n  .sw.sel { outline: 2px solid #000; }\n  #canvasWrap { position: relative; display: flex; flex-direction: column; min-width: 0; }\n  #c { width: 100%; height: 100%; image-rendering: pixelated; display: block; background: #ffffff; }\n  #hud { position: absolute; left: 8px; top: 8px; background: rgba(192,192,192,0.92); padding: 4px 6px; border: 2px solid #fff; border-bottom-color: #404040; border-right-color: #404040; font-size: 11px; pointer-events: none; }\n  #status { height: 22px; background: var(--face); border-top: 2px solid var(--light); display:flex; align-items:center; padding: 0 6px; gap: 12px; font-size: 11px; }\n  #dataList, #statsList { display: flex; flex-direction: column; gap: 4px; max-height: 28vh; overflow: auto; }\n  .item { padding: 3px 4px; border: 1px solid #000; background: #fff; cursor: pointer; }\n  .item:hover { background: #e8e8e8; }\n  .item.up { color: #006400; }\n  .item.down { color: #8b0000; }\n  .mono { font-family: Consolas, \"Lucida Console\", monospace; }\n  #actions { display: flex; flex-direction: column; gap: 6px; }\n  .cap { color: #202020; font-weight: bold; margin-bottom: 4px; }\n  #hint { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .tiny { font-size: 10px; color: #333; }\n  #stampBar { display:flex; flex-wrap: wrap; gap: 4px; }\n  .stamp { padding: 2px 4px; border: 1px solid #000; background:#fff; cursor:pointer; font-size: 14px; }\n  .stamp.sel { background:#d4d0c8; }\n  #previewBadge { position:absolute; right:8px; top:8px; background:#000080; color:#fff; padding:2px 6px; font-size:10px; opacity:0.8; }\n</style>\n\n<div id=\"root\">\n  <div id=\"win\" class=\"raised\">\n    <div class=\"titlebar\">\n      <div class=\"tleft\">\n        <div class=\"ticon\"></div>\n        <div class=\"ttxt\" id=\"winTitle\">Suica Paint — loading…</div>\n      </div>\n      <div class=\"tright tiny\" id=\"subtitle\"></div>\n    </div>\n    <div class=\"toolbar\">\n      <div class=\"panel raised\" style=\"padding:4px; gap:4px;\">\n        <button class=\"btn\" data-tool=\"brush\" title=\"Brush [1]\">✏️</button>\n        <button class=\"btn\" data-tool=\"eraser\" title=\"Eraser [2]\">🧽</button>\n        <button class=\"btn\" data-tool=\"roast\" title=\"Roast Pen [3]\">🔥</button>\n        <button class=\"btn\" data-tool=\"stamp\" title=\"Stamp [4]\">🖼️</button>\n        <div class=\"sep\"></div>\n        <button class=\"btn\" id=\"undoBtn\" title=\"Undo [Ctrl+Z]\">↶ Undo</button>\n        <div class=\"sep\"></div>\n        <div class=\"tiny\">Size</div>\n        <button class=\"btn\" id=\"sizeDec\" title=\"Smaller [-]\">−</button>\n        <div class=\"btn\" id=\"sizeVal\" style=\"pointer-events:none;\">4</div>\n        <button class=\"btn\" id=\"sizeInc\" title=\"Bigger [+]\">+</button>\n      </div>\n    </div>\n    <div id=\"content\">\n      <div id=\"left\">\n        <div class=\"box raised\">\n          <div class=\"cap\">Palette</div>\n          <div id=\"palette\"></div>\n        </div>\n        <div class=\"box raised\">\n          <div class=\"cap\">Stamps</div>\n          <div id=\"stampBar\"></div>\n        </div>\n      </div>\n      <div id=\"canvasWrap\" class=\"sunken\">\n        <canvas id=\"c\" width=\"960\" height=\"540\"></canvas>\n        <div id=\"hud\" class=\"mono\">\n          <div id=\"hudTitle\">Suica Paint</div>\n          <div id=\"hudMain\">—</div>\n        </div>\n        <div id=\"previewBadge\" style=\"display:none;\">PREVIEW</div>\n      </div>\n      <div id=\"right\">\n        <div class=\"box raised\">\n          <div class=\"cap\">Data Roast</div>\n          <div id=\"dataList\"></div>\n        </div>\n        <div class=\"box raised\">\n          <div class=\"cap\">Stats</div>\n          <div id=\"statsList\"></div>\n        </div>\n        <div class=\"box raised\">\n          <div class=\"cap\">Actions</div>\n          <div id=\"actions\"><div class=\"tiny\">No actions</div></div>\n        </div>\n      </div>\n    </div>\n    <div id=\"status\" class=\"mono\">\n      <div id=\"hint\">1 Brush, 2 Eraser, 3 Roast, 4 Stamp — [-]/[+] size — [ and ] cycle stamps — Ctrl+Z undo. Click a data item to paste.</div>\n      <div id=\"stTool\">Tool: Brush</div>\n      <div id=\"stColor\">Color: #000000</div>\n      <div id=\"stPos\">x:— y:—</div>\n    </div>\n  </div>\n</div>\n\n<script>\n(function(){\n  const $ = (q, el=document)=>el.querySelector(q);\n  const $$ = (q, el=document)=>Array.from(el.querySelectorAll(q));\n  const winTitle = $(\"#winTitle\");\n  const subtitle = $(\"#subtitle\");\n  const c = $(\"#c\");\n  const ctx = c.getContext(\"2d\");\n  ctx.imageSmoothingEnabled = false;\n  const hudTitle = $(\"#hudTitle\");\n  const hudMain = $(\"#hudMain\");\n  const paletteEl = $(\"#palette\");\n  const stampBar = $(\"#stampBar\");\n  const dataList = $(\"#dataList\");\n  const statsList = $(\"#statsList\");\n  const actionsEl = $(\"#actions\");\n  const stTool = $(\"#stTool\");\n  const stColor = $(\"#stColor\");\n  const stPos = $(\"#stPos\");\n  const sizeVal = $(\"#sizeVal\");\n  const previewBadge = $(\"#previewBadge\");\n\n  const tools = [\"brush\",\"eraser\",\"roast\",\"stamp\"];\n  const defaultPalette = [\n    \"#000000\",\"#7f7f7f\",\"#ffffff\",\"#800000\",\n    \"#ff0000\",\"#008000\",\"#00aa00\",\"#000080\",\n    \"#0000ff\",\"#808000\",\"#ffff00\",\"#008080\",\n    \"#00ffff\",\"#800080\",\"#ff00ff\",\"#a0522d\"\n  ];\n  const state = {\n    tool:\"brush\",\n    color:\"#000000\",\n    size:4,\n    down:false,\n    lastX:0, lastY:0,\n    docW:c.width, docH:c.height,\n    undo:[],\n    phrases:[\"paint app — waiting for data\"],\n    stamps:[\"🎨\",\"🖌️\",\"🧽\",\"🖼️\"],\n    stampIdx:0,\n    preview:false,\n    attractTimer: null,\n    readySent:false,\n    bundle:null, app:null\n  };\n\n  function clamp(n,min,max){ return Math.max(min, Math.min(max, n)); }\n  function setTool(t){\n    if(!tools.includes(t)) return;\n    state.tool = t;\n    $$(\".toolbar .btn\").forEach(b=>b.classList.toggle(\"active\", b.dataset.tool===t));\n    stTool.textContent = \"Tool: \" + (t.charAt(0).toUpperCase()+t.slice(1));\n  }\n  function setColor(col){\n    state.color = col;\n    stColor.textContent = \"Color: \" + col.toLowerCase();\n    $$(\".sw\").forEach(sw=>sw.classList.toggle(\"sel\", sw.dataset.c===col));\n  }\n  function setSize(n){\n    state.size = clamp(n,1,64);\n    sizeVal.textContent = state.size;\n  }\n  function buildPalette(bundle){\n    const cols = [...defaultPalette];\n    // list tones\n    if(bundle && bundle.list && Array.isArray(bundle.list.items)){\n      let ups = bundle.list.items.filter(it=>it.tone===\"up\").length;\n      let downs = bundle.list.items.filter(it=>it.tone===\"down\").length;\n      if(ups) cols.push(\"#007800\",\"#00c000\");\n      if(downs) cols.push(\"#780000\",\"#c00000\");\n    }\n    // gauge influence\n    if(bundle && bundle.gauge){\n      const v = clamp(bundle.gauge.value,0,1);\n      const r = Math.round(255*v), g = Math.round(255*(1-v));\n      cols.push(rgbToHex(r,g,48));\n    }\n    // grid risks\n    if(bundle && bundle.grid && Array.isArray(bundle.grid.cells)){\n      let found=false;\n      for(let row of bundle.grid.cells){\n        for(let cell of row){\n          const risk = clamp(cell.risk||0,0,1);\n          const col = riskToHex(risk);\n          if(!cols.includes(col)){ cols.push(col); found=true; if(cols.length>24) break; }\n        }\n        if(cols.length>24) break;\n      }\n      if(found) cols.push(\"#444444\");\n    }\n    // uniq and cap\n    const uniq = [];\n    for(const c of cols){ if(!uniq.includes(c)) uniq.push(c); if(uniq.length>=32) break; }\n    renderPalette(uniq);\n    if(!uniq.includes(state.color)) setColor(uniq[0]);\n  }\n  function rgbToHex(r,g,b){\n    const h = v=>(\"0\"+v.toString(16)).slice(-2);\n    return \"#\"+h(r)+h(g)+h(b);\n  }\n  function riskToHex(r){ // 0 green -> 1 red\n    const rr = Math.round(200*r+30);\n    const gg = Math.round(200*(1-r)+30);\n    return rgbToHex(rr, gg, 40);\n  }\n  function renderPalette(cols){\n    paletteEl.innerHTML = \"\";\n    cols.forEach(col=>{\n      const sw = document.createElement(\"div\");\n      sw.className = \"sw\";\n      sw.style.background = col;\n      sw.dataset.c = col;\n      if(col===state.color) sw.classList.add(\"sel\");\n      sw.onclick = ()=> setColor(col);\n      paletteEl.appendChild(sw);\n    });\n  }\n  function renderStamps(stamps){\n    stampBar.innerHTML = \"\";\n    state.stamps = stamps && stamps.length ? stamps.slice(0,24) : [\"🎨\",\"📉\",\"📈\",\"💎\",\"🧻\",\"🔥\",\"🤡\",\"⚠️\"];\n    if(state.stampIdx>=state.stamps.length) state.stampIdx = 0;\n    state.stamps.forEach((s,i)=>{\n      const b = document.createElement(\"button\");\n      b.className = \"stamp\" + (i===state.stampIdx ? \" sel\" : \"\");\n      b.textContent = s;\n      b.onclick = ()=>{ state.stampIdx=i; updateStampSel(); };\n      stampBar.appendChild(b);\n    });\n  }\n  function updateStampSel(){\n    $$(\".stamp\", stampBar).forEach((b,i)=>b.classList.toggle(\"sel\", i===state.stampIdx));\n  }\n  function addUndo(){\n    try{\n      if(state.undo.length>10) state.undo.shift();\n      const img = ctx.getImageData(0,0,state.docW,state.docH);\n      state.undo.push(img);\n    }catch(e){}\n  }\n  function undo(){\n    const img = state.undo.pop();\n    if(img){ ctx.putImageData(img,0,0); }\n  }\n  function getPos(e){\n    const r = c.getBoundingClientRect();\n    const sx = state.docW / r.width;\n    const sy = state.docH / r.height;\n    const x = (e.clientX - r.left) * sx;\n    const y = (e.clientY - r.top) * sy;\n    return {x: Math.round(x), y: Math.round(y)};\n  }\n  function lineTo(x,y,erase){\n    ctx.save();\n    ctx.lineJoin = \"round\";\n    ctx.lineCap = \"round\";\n    ctx.strokeStyle = erase ? \"#ffffff\" : state.color;\n    ctx.lineWidth = state.size;\n    ctx.beginPath();\n    ctx.moveTo(state.lastX, state.lastY);\n    ctx.lineTo(x,y);\n    ctx.stroke();\n    ctx.restore();\n    state.lastX = x; state.lastY = y;\n  }\n  function drawRoastAt(x,y){\n    const phrase = state.phrases[Math.floor(Math.random()*state.phrases.length)] || \"—\";\n    ctx.save();\n    ctx.fillStyle = state.color;\n    ctx.textBaseline = \"top\";\n    const fs = Math.max(8, Math.floor(state.size*3));\n    ctx.font = fs + \"px monospace\";\n    ctx.fillText(phrase, x, y);\n    ctx.restore();\n  }\n  function drawStampAt(x,y){\n    const s = state.stamps[state.stampIdx] || \"🎨\";\n    ctx.save();\n    ctx.textBaseline = \"middle\";\n    ctx.textAlign = \"center\";\n    const fs = Math.max(16, Math.floor(state.size*8));\n    ctx.font = fs + \"px sans-serif\";\n    ctx.fillText(s, x, y);\n    ctx.restore();\n  }\n  function clearCanvas(){\n    ctx.save();\n    ctx.fillStyle = \"#ffffff\";\n    ctx.fillRect(0,0,state.docW,state.docH);\n    ctx.restore();\n  }\n  function initCanvas(){\n    // already set width/height; rely on CSS scaling\n    clearCanvas();\n  }\n  function updateHUD(bundle){\n    const primary = pickPrimary(bundle);\n    hudTitle.textContent = bundle?.title || \"Suica Paint\";\n    hudMain.textContent = primary || \"—\";\n    winTitle.textContent = bundle?.title || \"Suica Paint\";\n    subtitle.textContent = bundle?.subtitle || \"\";\n  }\n  function pickPrimary(bundle){\n    if(!bundle) return \"\";\n    // table total first usd\n    const t = bundle.table;\n    if(t && t.total && t.columns){\n      const usdCol = t.columns.find(c=>c.fmt===\"usd\");\n      if(usdCol && t.total.hasOwnProperty(usdCol.key)){\n        const v = t.total[usdCol.key];\n        return typeof v === \"number\" ? suica.fmt.usd(v) : String(v);\n      }\n    }\n    // list first right\n    if(bundle.list && bundle.list.items && bundle.list.items.length){\n      const it = bundle.list.items[0];\n      if(it.right) return it.right;\n      if(it.subtitle) return it.subtitle;\n      return it.title || \"\";\n    }\n    // gauge\n    if(bundle.gauge){\n      const v = clamp(bundle.gauge.value,0,1);\n      return (bundle.gauge.label ? bundle.gauge.label + \": \" : \"\") + suica.fmt.pct(v);\n    }\n    // scene stats\n    if(bundle.scene && bundle.scene.stats && bundle.scene.stats.length){\n      const s = bundle.scene.stats[0];\n      return s.value;\n    }\n    // series\n    if(bundle.series && Array.isArray(bundle.series.points) && bundle.series.points.length){\n      const last = bundle.series.points[bundle.series.points.length-1];\n      return bundle.series.unit===\"usd\" ? suica.fmt.usd(last) : suica.fmt.pct(last/100);\n    }\n    return \"\";\n  }\n  function buildPhrases(bundle){\n    const arr = [];\n    // scene\n    if(bundle.scene){\n      if(bundle.scene.headline) arr.push(bundle.scene.headline);\n      if(bundle.scene.verdict) arr.push(bundle.scene.verdict);\n      if(Array.isArray(bundle.scene.lines)) arr.push(...bundle.scene.lines);\n      if(Array.isArray(bundle.scene.stats)) bundle.scene.stats.forEach(s=>arr.push(s.label + \": \" + s.value));\n    }\n    // list\n    if(bundle.list && Array.isArray(bundle.list.items)){\n      bundle.list.items.forEach(it=>{\n        if(it.title) arr.push(it.title);\n        if(it.subtitle) arr.push(it.subtitle);\n        if(it.right) arr.push(it.right);\n      });\n    }\n    // table\n    if(bundle.table && bundle.table.columns && Array.isArray(bundle.table.rows)){\n      const textCol = bundle.table.columns.find(c=>c.fmt===\"text\");\n      const usdCol = bundle.table.columns.find(c=>c.fmt===\"usd\");\n      bundle.table.rows.forEach(r=>{\n        const label = textCol ? r[textCol.key] : undefined;\n        const money = usdCol ? r[usdCol.key] : undefined;\n        let s = \"\";\n        if(label!=null) s += String(label);\n        if(money!=null){\n          const mv = typeof money===\"number\" ? suica.fmt.usd(money) : String(money);\n          s = s ? (s + \" — \" + mv) : mv;\n        }\n        if(s) arr.push(s);\n      });\n    }\n    // gauge/series as single-line\n    if(bundle.gauge){\n      arr.push((bundle.gauge.label||\"Gauge\") + \" \" + suica.fmt.pct(clamp(bundle.gauge.value,0,1)));\n      if(bundle.gauge.caption) arr.push(bundle.gauge.caption);\n    }\n    if(bundle.series && Array.isArray(bundle.series.points) && bundle.series.points.length){\n      const last = bundle.series.points[bundle.series.points.length-1];\n      const s = bundle.series.unit===\"usd\" ? suica.fmt.usd(last) : suica.fmt.pct(last);\n      arr.push((bundle.series.label||\"Series\") + \" \" + s);\n    }\n    state.phrases = arr.length ? arr.slice(0,200) : [\"no data — doodle freely\"];\n  }\n  function buildStamps(bundle){\n    let stamps = [];\n    if(bundle.scene && Array.isArray(bundle.scene.stamps) && bundle.scene.stamps.length){\n      stamps = bundle.scene.stamps.slice(0,24);\n    } else if(bundle.list && Array.isArray(bundle.list.items) && bundle.list.items.length){\n      const up = \"📈\", down=\"📉\";\n      bundle.list.items.forEach(it=>{\n        if(it.tone===\"up\") stamps.push(up);\n        else if(it.tone===\"down\") stamps.push(down);\n      });\n      stamps = stamps.length? stamps : [\"💎\",\"🧻\",\"🔥\",\"⚠️\"];\n    } else {\n      stamps = [\"🎨\",\"💰\",\"🔥\",\"⚠️\",\"📉\",\"📈\",\"🤡\",\"🧱\"];\n    }\n    renderStamps(stamps);\n  }\n  function renderDataLists(bundle){\n    // Right panel lists\n    dataList.innerHTML = \"\";\n    statsList.innerHTML = \"\";\n    // Data Roast lines (prioritize table -> list -> grid -> gauge -> scene -> series)\n    let hadAny=false;\n    if(bundle.table && bundle.table.columns && Array.isArray(bundle.table.rows) && bundle.table.rows.length){\n      const textCol = bundle.table.columns.find(c=>c.fmt===\"text\");\n      const usdCols = bundle.table.columns.filter(c=>c.fmt===\"usd\");\n      bundle.table.rows.slice(0,50).forEach(r=>{\n        const div = document.createElement(\"div\");\n        div.className = \"item mono\";\n        const label = textCol ? r[textCol.key] : undefined;\n        let line = label!=null ? String(label) : \"\";\n        if(usdCols.length){\n          const v = r[usdCols[0].key];\n          const sv = typeof v===\"number\" ? suica.fmt.usd(v) : String(v);\n          line = line ? (line + \" — \" + sv) : sv;\n        }\n        div.textContent = line || \"(row)\";\n        div.onclick = ()=> pasteText(line || \"\");\n        dataList.appendChild(div);\n        hadAny=true;\n      });\n      if(bundle.table.total){\n        const usdCol = bundle.table.columns.find(c=>c.fmt===\"usd\");\n        if(usdCol && bundle.table.total.hasOwnProperty(usdCol.key)){\n          const v = bundle.table.total[usdCol.key];\n          const sv = typeof v===\"number\" ? suica.fmt.usd(v) : String(v);\n          const tot = document.createElement(\"div\");\n          tot.className = \"item mono\";\n          tot.textContent = \"Total — \" + sv;\n          tot.onclick = ()=> pasteText(\"Total — \" + sv);\n          dataList.appendChild(tot);\n          hadAny=true;\n        }\n      }\n    } else if(bundle.list && Array.isArray(bundle.list.items) && bundle.list.items.length){\n      bundle.list.items.forEach(it=>{\n        const div = document.createElement(\"div\");\n        div.className = \"item mono\" + (it.tone ? (\" \" + it.tone) : \"\");\n        const parts = [it.title];\n        if(it.subtitle) parts.push(it.subtitle);\n        if(it.right) parts.push(it.right);\n        const line = parts.filter(Boolean).join(\" — \");\n        div.textContent = line;\n        div.onclick = ()=> pasteText(line);\n        dataList.appendChild(div);\n        hadAny=true;\n      });\n    } else if(bundle.scene && Array.isArray(bundle.scene.lines) && bundle.scene.lines.length){\n      bundle.scene.lines.forEach(s=>{\n        const div = document.createElement(\"div\");\n        div.className = \"item mono\";\n        div.textContent = s;\n        div.onclick = ()=> pasteText(s);\n        dataList.appendChild(div);\n        hadAny=true;\n      });\n    } else if(bundle.gauge){\n      const s = (bundle.gauge.label||\"Gauge\") + \" — \" + suica.fmt.pct(clamp(bundle.gauge.value,0,1));\n      const div = document.createElement(\"div\");\n      div.className = \"item mono\";\n      div.textContent = s;\n      div.onclick = ()=> pasteText(s);\n      dataList.appendChild(div);\n      hadAny=true;\n    } else if(bundle.series && Array.isArray(bundle.series.points) && bundle.series.points.length){\n      const last = bundle.series.points[bundle.series.points.length-1];\n      const s = (bundle.series.label||\"Series\") + \" — \" + (bundle.series.unit===\"usd\" ? suica.fmt.usd(last) : suica.fmt.pct(last));\n      const div = document.createElement(\"div\");\n      div.className = \"item mono\";\n      div.textContent = s;\n      div.onclick = ()=> pasteText(s);\n      dataList.appendChild(div);\n      hadAny=true;\n    }\n    if(!hadAny){\n      const div = document.createElement(\"div\");\n      div.className = \"tiny\";\n      div.textContent = \"No data items.\";\n      dataList.appendChild(div);\n    }\n    // Stats\n    if(bundle.scene && Array.isArray(bundle.scene.stats) && bundle.scene.stats.length){\n      bundle.scene.stats.forEach(s=>{\n        const div = document.createElement(\"div\");\n        div.className = \"item mono\";\n        div.textContent = s.label + \": \" + s.value;\n        div.onclick = ()=> pasteText(s.label + \": \" + s.value);\n        statsList.appendChild(div);\n      });\n    } else if(bundle.gauge){\n      const div = document.createElement(\"div\");\n      div.className = \"item mono\";\n      div.textContent = (bundle.gauge.label||\"Gauge\") + \": \" + suica.fmt.pct(clamp(bundle.gauge.value,0,1));\n      div.onclick = ()=> pasteText(div.textContent);\n      statsList.appendChild(div);\n      if(bundle.gauge.caption){\n        const d2 = document.createElement(\"div\");\n        d2.className = \"item mono\";\n        d2.textContent = bundle.gauge.caption;\n        d2.onclick = ()=> pasteText(d2.textContent);\n        statsList.appendChild(d2);\n      }\n    } else {\n      const div = document.createElement(\"div\");\n      div.className = \"tiny\";\n      div.textContent = \"No stats.\";\n      statsList.appendChild(div);\n    }\n    // Actions\n    actionsEl.innerHTML = \"\";\n    if(bundle.actions && bundle.actions.length){\n      bundle.actions.forEach(a=>{\n        const b = document.createElement(\"button\");\n        b.className = \"btn\";\n        if(a.primary) b.style.fontWeight=\"bold\";\n        b.textContent = a.label;\n        b.onclick = ()=> suica.propose(a.id);\n        actionsEl.appendChild(b);\n      });\n    } else {\n      const d = document.createElement(\"div\");\n      d.className = \"tiny\";\n      d.textContent = \"No actions\";\n      actionsEl.appendChild(d);\n    }\n  }\n  function pasteText(txt){\n    if(!txt) return;\n    // place at a random spot near center\n    const x = Math.round(state.docW*0.2 + Math.random()*state.docW*0.6);\n    const y = Math.round(state.docH*0.2 + Math.random()*state.docH*0.6);\n    addUndo();\n    ctx.save();\n    ctx.fillStyle = state.color;\n    const fs = Math.max(10, Math.floor(state.size*3));\n    ctx.font = fs + \"px monospace\";\n    ctx.textBaseline = \"top\";\n    ctx.fillText(txt, x, y);\n    ctx.restore();\n  }\n\n  // Input handlers\n  c.addEventListener(\"pointerdown\", (e)=>{\n    if(state.preview) return;\n    c.setPointerCapture(e.pointerId);\n    const p = getPos(e);\n    addUndo();\n    state.down = true;\n    state.lastX = p.x; state.lastY = p.y;\n    if(state.tool===\"stamp\"){\n      drawStampAt(p.x,p.y);\n    } else if(state.tool===\"roast\"){\n      drawRoastAt(p.x,p.y);\n    } else if(state.tool===\"brush\"){\n      lineTo(p.x,p.y,false);\n    } else if(state.tool===\"eraser\"){\n      lineTo(p.x,p.y,true);\n    }\n    updatePosStatus(p.x,p.y);\n  });\n  c.addEventListener(\"pointermove\", (e)=>{\n    const p = getPos(e);\n    if(state.down && !state.preview){\n      if(state.tool===\"brush\") lineTo(p.x,p.y,false);\n      else if(state.tool===\"eraser\") lineTo(p.x,p.y,true);\n      else if(state.tool===\"roast\") drawRoastAt(p.x,p.y);\n      else if(state.tool===\"stamp\"){ /* hold to spam? */ drawStampAt(p.x,p.y); }\n    }\n    updatePosStatus(p.x,p.y);\n  });\n  window.addEventListener(\"pointerup\", ()=>{\n    state.down = false;\n  });\n  function updatePosStatus(x,y){\n    stPos.textContent = \"x:\" + x + \" y:\" + y;\n  }\n  // Toolbar buttons\n  $$(\".toolbar [data-tool]\").forEach(b=>{\n    b.addEventListener(\"click\", ()=> setTool(b.dataset.tool));\n  });\n  $(\"#undoBtn\").onclick = ()=> undo();\n  $(\"#sizeInc\").onclick = ()=> setSize(state.size+1);\n  $(\"#sizeDec\").onclick = ()=> setSize(state.size-1);\n\n  // Keyboard\n  window.addEventListener(\"keydown\", (e)=>{\n    if(state.preview) return;\n    if(e.ctrlKey && (e.key===\"z\" || e.key===\"Z\")){ e.preventDefault(); undo(); return; }\n    if(e.key===\"1\") setTool(\"brush\");\n    else if(e.key===\"2\") setTool(\"eraser\");\n    else if(e.key===\"3\") setTool(\"roast\");\n    else if(e.key===\"4\") setTool(\"stamp\");\n    else if(e.key===\"+\" || e.key===\"=\") setSize(state.size+1);\n    else if(e.key===\"-\" || e.key===\"_\") setSize(state.size-1);\n    else if(e.key===\"[\" ){ state.stampIdx=(state.stampIdx-1+state.stamps.length)%state.stamps.length; updateStampSel(); }\n    else if(e.key===\"]\" ){ state.stampIdx=(state.stampIdx+1)%state.stamps.length; updateStampSel(); }\n  });\n\n  // Preview attract mode\n  function startAttract(bundle){\n    stopAttract();\n    previewBadge.style.display = \"block\";\n    // draw soft background grid\n    ctx.save();\n    ctx.fillStyle = \"#ffffff\";\n    ctx.fillRect(0,0,state.docW,state.docH);\n    ctx.strokeStyle = \"#e6e6e6\";\n    ctx.lineWidth = 1;\n    for(let x=0;x<state.docW;x+=20){ ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,state.docH); ctx.stroke(); }\n    for(let y=0;y<state.docH;y+=20){ ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(state.docW,y); ctx.stroke(); }\n    ctx.restore();\n    // Auto paint stamps and phrases\n    let i=0, j=0;\n    state.attractTimer = setInterval(()=>{\n      const x = Math.round((0.1+0.8*Math.random())*state.docW);\n      const y = Math.round((0.1+0.8*Math.random())*state.docH);\n      if(i%2===0){\n        drawStampAt(x,y);\n      } else {\n        drawRoastAt(x,y);\n      }\n      i++;\n      j++;\n      if(j>24){ stopAttract(); }\n    }, 120);\n  }\n  function stopAttract(){\n    if(state.attractTimer){ clearInterval(state.attractTimer); state.attractTimer=null; }\n    previewBadge.style.display = \"none\";\n  }\n\n  function firstFrameReady(){\n    if(!state.readySent){\n      state.readySent = true;\n      try{ suica.ready(); }catch(e){}\n    }\n  }\n\n  function onData({bundle, app}){\n    state.bundle = bundle; state.app = app||{};\n    state.preview = !!(state.app && state.app.preview);\n    // Init canvas only once on first data if blank\n    if(!state.readySent){ initCanvas(); }\n    // UI\n    updateHUD(bundle);\n    buildPhrases(bundle);\n    buildStamps(bundle);\n    buildPalette(bundle);\n    renderDataLists(bundle);\n    // default selections influenced by tone\n    if(bundle.list && bundle.list.items && bundle.list.items.length){\n      const t = bundle.list.items[0].tone;\n      if(t===\"up\") setColor(\"#007800\");\n      else if(t===\"down\") setColor(\"#a00000\");\n    }\n    setTool(state.tool); // refresh UI\n    setSize(state.size);\n\n    // Preview mode\n    if(state.preview){ startAttract(bundle); } else { stopAttract(); }\n\n    // Ready after first paint\n    firstFrameReady();\n  }\n\n  suica.onData(onData);\n\n  // Ensure canvas scales to container on resize while preserving content (CSS scale)\n  function onResize(){\n    const wrap = $(\"#canvasWrap\");\n    // just update CSS size via flex; canvas style is 100% so no action required\n  }\n  window.addEventListener(\"resize\", onResize);\n\n  // Boot defaults\n  setTool(\"brush\");\n  setColor(\"#000000\");\n  setSize(4);\n})();\n</script>","blobId":"GunH-tTaBrChtTX_hySbmgR0XKMH9XOLSKR7UDb8feU","ens":"paint-app.shells.suica.eth"}