{"label":"snake","name":"snake","exe":"SNAKE.EXE","sha256":"3283b303347e735c474fd43545a4bbe1d5e6548dfecdde5e4786656cef4976c4","bytes":22483,"model":"openai/gpt-5","createdAt":1790432100075,"installedBy":"qa-carol","published":true,"html":"<style>\n  :root { --face:#c0c0c0; --edge:#808080; --hi:#fff; --shadow:#000; --navy:#000080; --green:#007800; --red:#b00000; }\n  * { box-sizing:border-box; }\n  #snake98 { position:fixed; inset:0; display:flex; flex-direction:column; background:var(--face); font-family:Tahoma, Verdana, Geneva, sans-serif; color:#000; }\n  .title { height:26px; line-height:26px; padding:0 8px; background:linear-gradient(#000080,#000060); color:#fff; display:flex; align-items:center; justify-content:space-between; font-weight:bold; user-select:none; }\n  .mono { font-family:Consolas, \"Courier New\", monospace; }\n  .raised { border:2px outset var(--face); }\n  .sunken { border:2px inset var(--face); }\n  .btn { display:inline-block; padding:2px 10px; background:var(--face); border:2px outset var(--face); cursor:pointer; user-select:none; }\n  .btn:active { border:2px inset var(--face); }\n  .bar { height:28px; padding:2px 6px; display:flex; align-items:center; gap:8px; background:#d4d0c8; }\n  #main { flex:1; position:relative; margin:6px; display:flex; gap:6px; min-height:0; }\n  #view { position:relative; flex:1; }\n  #cv { position:absolute; inset:0; image-rendering: pixelated; image-rendering: crisp-edges; }\n  #hud { position:absolute; left:8px; top:8px; padding:6px 8px; background:#e5e5e5; opacity:0.95; font-size:12px; max-width:50%; }\n  #legend { width:260px; min-width:200px; max-width:40vw; background:#e5e5e5; padding:6px; overflow:auto; }\n  #legend h3 { margin:2px 0 6px; font-size:12px; }\n  #legend .row { display:flex; align-items:center; justify-content:space-between; padding:2px 4px; gap:6px; font-size:12px; white-space:nowrap; }\n  #legend .row:nth-child(odd){ background:#f3f3f3; }\n  .pill { padding:0 6px; border-radius:10px; font-size:11px; }\n  .up { color:#006400; }\n  .down { color:#8b0000; }\n  #overlay { position:absolute; inset:0; display:none; align-items:center; justify-content:center; }\n  #overlay .panel { background:#e5e5e5; padding:12px; width:min(420px,90vw); }\n  #hint { flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:12px; }\n  #actions { display:flex; gap:6px; flex-wrap:wrap; }\n  .title .right { display:flex; align-items:center; gap:10px; font-weight:normal; }\n</style>\n\n<div id=\"snake98\" class=\"raised\">\n  <div id=\"top\" class=\"title\">\n    <div id=\"titleTxt\">SNAKE — loading…</div>\n    <div class=\"right mono\" id=\"topRight\"></div>\n  </div>\n  <div id=\"main\">\n    <div id=\"view\" class=\"raised\">\n      <canvas id=\"cv\"></canvas>\n      <div id=\"hud\" class=\"sunken mono\">\n        <div id=\"hudLine1\">Waiting for data…</div>\n        <div id=\"hudLine2\"></div>\n      </div>\n      <div id=\"overlay\">\n        <div class=\"panel raised\">\n          <div style=\"font-weight:bold; margin-bottom:6px;\" id=\"ovTitle\">Game Over</div>\n          <div id=\"ovBody\" style=\"font-size:12px; margin-bottom:8px;\"></div>\n          <div style=\"display:flex; gap:6px; flex-wrap:wrap;\">\n            <div class=\"btn\" id=\"btnRestart\">Restart</div>\n            <div class=\"btn\" id=\"btnPrimary\" style=\"display:none;\"></div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div id=\"legend\" class=\"raised\">\n      <h3 class=\"title\" style=\"height:22px; line-height:22px; padding:0 6px; font-weight:bold;\">Assets on the board</h3>\n      <div id=\"legendList\"></div>\n    </div>\n  </div>\n  <div class=\"bar raised\">\n    <div id=\"hint\" class=\"mono\">Arrows/WASD to steer • Space pause • R restart • Enter to run primary action</div>\n    <div id=\"actions\"></div>\n  </div>\n</div>\n\n<script>\n(function(){\n  // DOM\n  const cv = document.getElementById('cv');\n  const ctx = cv.getContext('2d');\n  const titleTxt = document.getElementById('titleTxt');\n  const topRight = document.getElementById('topRight');\n  const hud1 = document.getElementById('hudLine1');\n  const hud2 = document.getElementById('hudLine2');\n  const legendList = document.getElementById('legendList');\n  const overlay = document.getElementById('overlay');\n  const ovTitle = document.getElementById('ovTitle');\n  const ovBody = document.getElementById('ovBody');\n  const btnRestart = document.getElementById('btnRestart');\n  const btnPrimary = document.getElementById('btnPrimary');\n  const actionsBar = document.getElementById('actions');\n\n  // Game state\n  let gridW=32, gridH=24, cell=16;\n  let snake = [{x:5,y:5}];\n  let dir = {x:1,y:0}, nextDir = {x:1,y:0};\n  let grow=0, tick=0, speed=8, paused=false, dead=false;\n  let rngSeed = 123456;\n  let assets = [];       // catalog of items from data\n  let foods = [];        // active foods on board\n  let eaten = [];        // eaten records\n  let pool = [];         // spawn queue\n  let maxFoods = 6;\n  let lastEatenInfo = null;\n  let hasUSD = false;\n  let scoreUSD = 0;\n  let readyCalled = false;\n  let appMeta = {title:'', preview:false};\n  let bundleData = null;\n  let importantText = '';\n  let primaryAction = null;\n\n  function sRand(){\n    // xorshift32\n    let x = rngSeed|0;\n    x ^= x << 13; x ^= x >>> 17; x ^= x << 5;\n    rngSeed = x|0;\n    return ((x>>>0) / 4294967296);\n  }\n  function shuffle(a){\n    for(let i=a.length-1;i>0;i--){\n      const j = Math.floor(sRand()*(i+1));\n      const t=a[i]; a[i]=a[j]; a[j]=t;\n    }\n    return a;\n  }\n\n  function fmtUSD(n){\n    try { return window.suica && suica.fmt ? suica.fmt.usd(n) : ('$'+n.toFixed(2)); } catch(e){ return '$'+n.toFixed(2); }\n  }\n  function fmtPct(n){\n    try { return window.suica && suica.fmt ? suica.fmt.pct(n/100) : (n.toFixed(1)+'%'); } catch(e){ return n.toFixed(1)+'%'; }\n  }\n\n  function resize(){\n    const view = document.getElementById('view');\n    const pad = 0;\n    const w = Math.max(200, view.clientWidth - pad);\n    const h = Math.max(160, view.clientHeight - pad);\n    // Choose integer cell size for crisp pixels\n    const targetCols = 40;\n    const targetRows = 26;\n    const cellX = Math.max(8, Math.floor(w/targetCols));\n    const cellY = Math.max(8, Math.floor(h/targetRows));\n    cell = Math.max(8, Math.min(24, Math.min(cellX, cellY)));\n    gridW = Math.max(12, Math.floor(w / cell));\n    gridH = Math.max(10, Math.floor(h / cell));\n    cv.width = gridW * cell;\n    cv.height = gridH * cell;\n    // Clamp snake within bounds\n    snake.forEach(p => { p.x = Math.max(0, Math.min(gridW-1, p.x)); p.y = Math.max(0, Math.min(gridH-1, p.y)); });\n    // Reposition any off-board foods\n    foods.forEach(f => { if (f.x>=gridW||f.y>=gridH){ placeFoodOnEmpty(f); }});\n    draw(true);\n  }\n  window.addEventListener('resize', resize);\n\n  function emptyCellsSet(){\n    const occ = new Set();\n    snake.forEach(p => occ.add(p.x+','+p.y));\n    foods.forEach(f => occ.add(f.x+','+f.y));\n    return occ;\n  }\n  function placeFoodOnEmpty(food){\n    const occ = emptyCellsSet();\n    let tries = 0;\n    while(tries<1000){\n      const x = Math.floor(sRand()*gridW);\n      const y = Math.floor(sRand()*gridH);\n      const k = x+','+y;\n      if(!occ.has(k)){\n        food.x=x; food.y=y; return;\n      }\n      tries++;\n    }\n    // fallback\n    food.x = Math.floor(gridW/2);\n    food.y = Math.floor(gridH/2);\n  }\n\n  function extractFromTable(table){\n    const cols = table.columns || [];\n    const rows = Array.isArray(table.rows)? table.rows: [];\n    if (!rows.length) return [];\n    // find label (first text)\n    let labelKey = null, valueKey = null, changeKey = null, pnlKey = null;\n    for (const c of cols){ if (c.fmt === 'text' && !labelKey) labelKey = c.key; }\n    for (const c of cols){ if ((c.key==='value' || c.fmt==='usd') && !valueKey) valueKey = c.key; }\n    for (const c of cols){ if (c.fmt==='pct' && !changeKey) changeKey = c.key; }\n    for (const c of cols){ if (c.fmt==='usd' && c.key!=='value' && c.key!==valueKey && !pnlKey) pnlKey = c.key; }\n    const out = [];\n    for (const r of rows){\n      let label = labelKey? String(r[labelKey]) : (('' + (r.asset || r.token || 'Asset')));\n      let usd = 0;\n      if (valueKey && typeof r[valueKey] === 'number') usd = r[valueKey];\n      const change = (changeKey && typeof r[changeKey]==='number') ? r[changeKey] : null;\n      const pnl = (pnlKey && typeof r[pnlKey]==='number') ? r[pnlKey] : null;\n      out.push({label, usd, change, pnl, unit:'usd', raw:r});\n    }\n    return out.filter(a => isFinite(a.usd) && a.usd>=0);\n  }\n  function extractFromList(list){\n    const items = (list && list.items) ? list.items : [];\n    const out=[];\n    for(const it of items){\n      const label = it.title || (it.subtitle||'Item');\n      let usd = 0;\n      if (it.right && typeof it.right === 'string'){\n        const m = it.right.replace(/[^0-9\\.\\-]/g,'');\n        usd = parseFloat(m) || 0;\n      }\n      const change = null;\n      const tone = it.tone || null;\n      out.push({label, usd, change, pnl:null, tone, unit:'usd', raw:it});\n    }\n    return out;\n  }\n  function extractFallback(bundle){\n    // Try series\n    if (bundle.series && Array.isArray(bundle.series.points) && bundle.series.points.length){\n      const unit = bundle.series.unit === 'usd' ? 'usd' : (bundle.series.unit==='pct' ? 'pct':'num');\n      return bundle.series.points.map((v,i)=>({\n        label: (bundle.series.label||'Series')+' #'+(i+1),\n        usd: unit==='usd'? v:0,\n        value: v,\n        change: null, pnl:null, unit\n      }));\n    }\n    // Try gauge\n    if (bundle.gauge){\n      const v = bundle.gauge.value;\n      return [{label: bundle.gauge.label || 'Gauge', usd:0, value:v, unit:'pct', change:null, pnl:null}];\n    }\n    // Nothing\n    return [];\n  }\n\n  function calcImportant(bundle){\n    // Top right number: prefer total.value usd, else series last point if unit usd, else first list right, else gauge %, else blank\n    let text='';\n    if (bundle.table && bundle.table.total){\n      const tot = bundle.table.total;\n      const keys = Object.keys(tot);\n      // try explicit 'value' as usd\n      if (typeof tot.value==='number') text = 'Total ' + fmtUSD(tot.value);\n      else {\n        // first numeric usd-like? Can't know fmt; fallback to value\n        for(const k of keys){ if (typeof tot[k]==='number'){ text = 'Total '+tot[k]; break; } }\n      }\n      // show PnL if present\n      if (typeof tot.pnl==='number'){\n        const sign = tot.pnl>0?'+':'';\n        text += ' · 30d PnL ' + fmtUSD(tot.pnl).replace('$-','-$').replace('$+','+$');\n      }\n      return text;\n    }\n    if (bundle.series && bundle.series.unit==='usd' && bundle.series.points && bundle.series.points.length){\n      const v = bundle.series.points[bundle.series.points.length-1];\n      return 'Now ' + fmtUSD(v);\n    }\n    if (bundle.list && bundle.list.items && bundle.list.items.length){\n      const r = String(bundle.list.items[0].right||'');\n      return r ? ('Top ' + r) : '';\n    }\n    if (bundle.gauge){\n      return (bundle.gauge.label||'Gauge')+': '+Math.round(bundle.gauge.value*100)+'%';\n    }\n    return '';\n  }\n\n  function buildAssets(bundle){\n    let a=[];\n    if (bundle.table) a = extractFromTable(bundle.table);\n    else if (bundle.list) a = extractFromList(bundle.list);\n    else a = extractFallback(bundle);\n    // Deduplicate labels that repeat (like CATE multiple rows)\n    a = a.map((x,i)=>({id:i, ...x}));\n    // Determine if there is any USD\n    hasUSD = a.some(x => (x.unit==='usd' && typeof x.usd === 'number' && isFinite(x.usd)));\n    // We need at least some items; if empty, show empty state via legend\n    return a;\n  }\n\n  function colorFor(change, tone){\n    if (typeof change === 'number'){\n      if (change > 0) return '#15803d';\n      if (change < 0) return '#b91c1c';\n      return '#666';\n    }\n    if (tone==='up') return '#15803d';\n    if (tone==='down') return '#b91c1c';\n    return '#404040';\n  }\n\n  function resetGame(full=true){\n    snake = [{x:Math.floor(gridW/2),y:Math.floor(gridH/2)}];\n    dir = {x:1,y:0}; nextDir={x:1,y:0}; grow=3; tick=0; paused=appMeta.preview?false:false; dead=false;\n    foods = [];\n    eaten = [];\n    pool = shuffle(assets.slice()); // randomize spawn order\n    scoreUSD = 0;\n    lastEatenInfo = null;\n    maxFoods = Math.max(3, Math.min(8, Math.floor((gridW*gridH)/200)));\n    // Pre-spawn a few\n    for(let i=0;i<Math.min(maxFoods,2+(pool.length>10?3:1));i++) spawnFood();\n    draw(true);\n  }\n\n  function spawnFood(){\n    if (!pool.length) return;\n    const item = pool.pop();\n    const f = {\n      x:0,y:0,\n      label:item.label,\n      usd:(item.unit==='usd'&&isFinite(item.usd))?item.usd:0,\n      value: (item.unit==='pct'||item.unit==='num')? item.value||0 : item.usd||0,\n      unit:item.unit||'usd',\n      change:item.change,\n      pnl:item.pnl,\n      tone:item.tone||null,\n      weight:0\n    };\n    // Weight by USD for spawn size glow radius (visual only)\n    let w = 1;\n    if (f.unit==='usd'){\n      const vals = assets.map(z=>z.usd||0).filter(isFinite);\n      const max = Math.max(1, ...vals);\n      w = Math.max(1, Math.round((f.usd / max) * 4));\n    } else if (f.unit==='pct'){\n      w = Math.max(1, Math.round(Math.abs(f.value)*0.5/25)); // coarse scaling\n    }\n    f.weight = w;\n    placeFoodOnEmpty(f);\n    foods.push(f);\n  }\n\n  function draw(first){\n    // bg\n    ctx.fillStyle = '#9a9a9a';\n    ctx.fillRect(0,0,cv.width,cv.height);\n    // grid bevel fake\n    for(let y=0;y<gridH;y++){\n      for(let x=0;x<gridW;x++){\n        const px = x*cell, py=y*cell;\n        ctx.fillStyle = ((x+y)&1)?'#bdbdbd':'#c9c9c9';\n        ctx.fillRect(px+1,py+1,cell-2,cell-2);\n      }\n    }\n    // foods\n    for(const f of foods){\n      const px = f.x*cell, py=f.y*cell;\n      const col = colorFor(f.change, f.tone);\n      ctx.fillStyle = '#000';\n      ctx.fillRect(px+2,py+2,cell-4,cell-4);\n      ctx.fillStyle = col;\n      ctx.fillRect(px+3,py+3,cell-6,cell-6);\n      // Shine depending on weight\n      ctx.fillStyle = 'rgba(255,255,255,0.35)';\n      const s = Math.max(2, Math.min(cell-8, f.weight*2));\n      ctx.fillRect(px+3, py+3, s, 3);\n    }\n    // snake\n    for(let i=0;i<snake.length;i++){\n      const p = snake[i];\n      const px = p.x*cell, py = p.y*cell;\n      const head = (i===snake.length-1);\n      ctx.fillStyle = head ? '#004080' : '#005aa0';\n      ctx.fillRect(px+1,py+1,cell-2,cell-2);\n      // 98 bevel\n      ctx.fillStyle = 'rgba(255,255,255,0.25)';\n      ctx.fillRect(px+1,py+1,cell-2,2);\n      ctx.fillRect(px+1,py+1,2,cell-2);\n      ctx.fillStyle = 'rgba(0,0,0,0.25)';\n      ctx.fillRect(px+1,py+cell-3,cell-2,2);\n      ctx.fillRect(px+cell-3,py+1,2,cell-2);\n    }\n\n    // HUD text\n    const eatenCount = eaten.length;\n    const l1 = appMeta.title ? appMeta.title : '—';\n    let l2 = 'Assets eaten: '+eatenCount;\n    if (hasUSD) l2 += ' · Collected '+fmtUSD(scoreUSD);\n    if (lastEatenInfo){\n      l2 += ' · Last: '+lastEatenInfo;\n    }\n    hud1.textContent = l1;\n    hud2.textContent = l2;\n\n    // Legend render\n    renderLegend();\n\n    // Ensure we notify ready after first real draw\n    if (!readyCalled && bundleData){\n      readyCalled = true;\n      try { suica.ready(); } catch(e){}\n    }\n  }\n\n  function renderLegend(){\n    const topK = Math.min(20, assets.length);\n    // sort by usd desc if usd exists otherwise by value\n    const sorted = assets.slice().sort((a,b)=>{\n      const au = isFinite(a.usd)?a.usd: (isFinite(a.value)?a.value:0);\n      const bu = isFinite(b.usd)?b.usd: (isFinite(b.value)?b.value:0);\n      return bu - au;\n    }).slice(0, topK);\n    const nowOnBoard = new Set(foods.map(f=>f.label));\n    const html = sorted.map(it=>{\n      const u = (it.unit==='usd' && isFinite(it.usd)) ? fmtUSD(it.usd) :\n                (typeof it.value==='number' ? (it.unit==='pct'? it.value.toFixed(1)+'%': String(it.value)) : '');\n      const toneC = (typeof it.change==='number' && it.change!==0) ? (it.change>0?'up':'down') : (it.tone||'');\n      const ch = (typeof it.change==='number') ? (it.change>0?'+':'')+it.change.toFixed(1)+'%' : '';\n      const right = [u, ch].filter(Boolean).join(' · ');\n      const dot = nowOnBoard.has(it.label) ? '●' : '○';\n      const dotCol = nowOnBoard.has(it.label) ? '#008000' : '#666';\n      return `<div class=\"row\">\n        <span class=\"mono\" style=\"overflow:hidden;text-overflow:ellipsis;max-width:55%;\"><span style=\"color:${dotCol};margin-right:4px\">${dot}</span>${escapeHtml(it.label)}</span>\n        <span class=\"mono ${toneC}\">${escapeHtml(right)}</span>\n      </div>`;\n    }).join('');\n    legendList.innerHTML = html || `<div class=\"row\">No items to show.</div>`;\n  }\n\n  function escapeHtml(s){ return String(s).replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c])); }\n\n  function gameStep(dt){\n    if (paused || dead) return;\n    tick += dt;\n    const step = 1/speed;\n    if (tick >= step){\n      tick -= step;\n      // Smooth: apply nextDir if not reversing\n      if ((nextDir.x !== -dir.x) || (nextDir.y !== -dir.y)){\n        dir = nextDir;\n      }\n      const head = snake[snake.length-1];\n      let nx = head.x + dir.x;\n      let ny = head.y + dir.y;\n\n      // Preview mode: wrap around; Normal: die on wall\n      const wrap = appMeta.preview;\n      if (wrap){\n        if (nx<0) nx=gridW-1; if (nx>=gridW) nx=0;\n        if (ny<0) ny=gridH-1; if (ny>=gridH) ny=0;\n      }\n\n      // Move\n      snake.push({x:nx, y:ny});\n      // Check collisions\n      let hitWall = (nx<0 || nx>=gridW || ny<0 || ny>=gridH);\n      let hitSelf = false;\n      if (!hitWall){\n        for (let i=0;i<snake.length-1;i++){\n          const p = snake[i];\n          if (p.x===nx && p.y===ny){ hitSelf=true; break; }\n        }\n      }\n\n      if (!appMeta.preview && (hitWall || hitSelf)){\n        dead = true;\n        showOverlay('Game Over', summaryText());\n        return;\n      }\n\n      // Eat?\n      let ate = false;\n      for (let i=0;i<foods.length;i++){\n        const f = foods[i];\n        if (f.x===nx && f.y===ny){\n          ate = true;\n          grow += Math.max(2, f.weight+1);\n          const parts = [];\n          if (f.unit==='usd' && isFinite(f.usd)){ scoreUSD += f.usd; parts.push(fmtUSD(f.usd)); }\n          if (typeof f.change==='number'){ parts.push((f.change>0?'+':'')+f.change.toFixed(1)+'%'); }\n          if (typeof f.pnl==='number'){ parts.push('PnL '+fmtUSD(f.pnl)); }\n          lastEatenInfo = f.label + ' · ' + parts.join(' · ');\n          eaten.push({label:f.label, usd:f.usd||0, unit:f.unit, change:f.change, pnl:f.pnl});\n          foods.splice(i,1);\n          // Spawn next\n          if (pool.length) spawnFood();\n          break;\n        }\n      }\n      if (!ate){\n        if (grow>0) { grow--; } else { snake.shift(); }\n      }\n    }\n  }\n\n  function summaryText(){\n    const n = eaten.length;\n    const usdTxt = hasUSD ? (' · Collected '+fmtUSD(scoreUSD)) : '';\n    return 'You ate '+n+' item'+(n===1?'':'s')+usdTxt+'.';\n  }\n\n  let lastTS = 0;\n  function loop(ts){\n    if (!lastTS) lastTS = ts;\n    const dt = Math.min(0.1, (ts - lastTS)/1000);\n    lastTS = ts;\n    gameStep(dt);\n    draw(false);\n    requestAnimationFrame(loop);\n  }\n\n  function showOverlay(title, body){\n    ovTitle.textContent = title;\n    ovBody.textContent = body;\n    overlay.style.display = 'flex';\n  }\n  function hideOverlay(){\n    overlay.style.display = 'none';\n  }\n\n  function setPaused(p){\n    paused = p;\n    if (paused) showOverlay('Paused', 'Take a breather. Press Space to resume.');\n    else hideOverlay();\n  }\n\n  // Input\n  const keyMap = {\n    ArrowUp:{x:0,y:-1}, ArrowDown:{x:0,y:1}, ArrowLeft:{x:-1,y:0}, ArrowRight:{x:1,y:0},\n    w:{x:0,y:-1}, s:{x:0,y:1}, a:{x:-1,y:0}, d:{x:1,y:0},\n    W:{x:0,y:-1}, S:{x:0,y:1}, A:{x:-1,y:0}, D:{x:1,y:0}\n  };\n  window.addEventListener('keydown', (e)=>{\n    if (appMeta.preview) return; // no input in preview\n    if (keyMap[e.key]){\n      const nd = keyMap[e.key];\n      // Prevent direct reverse\n      if (!(nd.x === -dir.x && nd.y === -dir.y)){\n        nextDir = nd;\n      }\n    } else if (e.key===' '){\n      e.preventDefault();\n      if (dead){ resetGame(false); hideOverlay(); return; }\n      setPaused(!paused);\n    } else if (e.key==='r' || e.key==='R'){\n      resetGame(false); hideOverlay();\n    } else if (e.key==='Enter'){\n      if (primaryAction){\n        try { suica.propose(primaryAction.id); } catch(err){}\n      }\n    }\n  });\n\n  btnRestart.addEventListener('click', ()=>{ resetGame(false); hideOverlay(); });\n  btnPrimary.addEventListener('click', ()=>{\n    if (primaryAction){ try { suica.propose(primaryAction.id); } catch(e){} }\n  });\n\n  function renderActions(bundle){\n    actionsBar.innerHTML = '';\n    const acts = Array.isArray(bundle.actions)? bundle.actions : [];\n    primaryAction = null;\n    if (acts.length){\n      primaryAction = acts.find(a=>a.primary) || acts[0];\n      for(const a of acts){\n        const el = document.createElement('div');\n        el.className = 'btn';\n        el.textContent = a.label || 'Action';\n        el.addEventListener('click', ()=>{ try { suica.propose(a.id); } catch(e){} });\n        actionsBar.appendChild(el);\n      }\n      btnPrimary.style.display = 'inline-block';\n      btnPrimary.textContent = primaryAction.label || 'Primary Action';\n    } else {\n      btnPrimary.style.display = 'none';\n    }\n  }\n\n  function updateTopBar(bundle){\n    titleTxt.textContent = 'SNAKE — ' + (bundle.title || 'live');\n    const imp = calcImportant(bundle);\n    importantText = imp;\n    topRight.textContent = imp;\n  }\n\n  function rebuildFromData({bundle, app}){\n    bundleData = bundle;\n    appMeta.title = bundle.title || '';\n    appMeta.preview = !!(app && app.preview);\n    updateTopBar(bundle);\n    renderActions(bundle);\n\n    assets = buildAssets(bundle);\n    // If we have no assets, populate legend with empty state and still draw a frame\n    if (!assets.length){\n      legendList.innerHTML = `<div class=\"row\">No data available. Try again later.</div>`;\n      hud1.textContent = appMeta.title || '—';\n      hud2.textContent = 'No rows to play with.';\n      draw(true);\n      return;\n    }\n\n    // HUD important line\n    if (bundle.table && bundle.table.total){\n      const t = bundle.table.total;\n      // Show 'TOTAL' row too in legend top\n      // not adding as food; only display in HUD.\n    }\n\n    // Reset game while preserving preview mode\n    resetGame(true);\n  }\n\n  // Initial resize and start loop\n  resize();\n  requestAnimationFrame(loop);\n\n  // Hook data\n  if (window.suica && suica.onData){\n    suica.onData((data)=>{\n      try {\n        rebuildFromData(data);\n        // draw called within rebuild/reset; suica.ready() will be called in draw after first frame\n      } catch(e){\n        // In case of unexpected error, still try to draw and call ready\n        draw(true);\n      }\n    });\n  } else {\n    // Fallback: draw anyway\n    draw(true);\n  }\n\n})();\n</script>","blobId":"ks22gMwL70R1e6Q_5L8NKH-shx52vybV9DdCBEM91uE","ens":"snake.shells.suica.eth"}