{"label":"excel-sheet","name":"excel sheet","exe":"EXCELSHE.EXE","sha256":"a2b7860b0741c8555015b9f7b49d989717dc8eeb4edf6526a11d38ebf23387b2","bytes":22905,"model":"openai/gpt-5","createdAt":1790433881996,"installedBy":"guest","published":true,"html":"<style>\n/* Windows 98 + Excel vibes */\n:root { --face:#c0c0c0; --dark:#808080; --light:#fff; --shadow:#000080; --text:#000; --sel:#0000aa; }\nhtml,body { margin:0; height:100%; }\n#excel98 { width:100vw; height:100vh; background:var(--face); color:var(--text); font:13px Tahoma, \"MS Sans Serif\", Arial, sans-serif; display:flex; flex-direction:column; }\n.raised { border:2px solid; border-color:var(--light) var(--dark) var(--dark) var(--light); background:var(--face); }\n.sunken { border:2px solid; border-color:var(--dark) var(--light) var(--light) var(--dark); background:#fff; }\n.title { background:linear-gradient(to right, #000080, #1084d0); color:#fff; padding:3px 8px; font-weight:bold; user-select:none; }\n.winbar { display:flex; align-items:center; gap:8px; padding:3px 6px; }\n.menubar { padding:2px 6px; user-select:none; }\n.menubar span { margin-right:10px; text-decoration:underline; }\n.btn { padding:2px 8px; border:2px solid; border-color:var(--light) var(--dark) var(--dark) var(--light); background:#e0e0e0; cursor:pointer; }\n.btn:active { border-color:var(--dark) var(--light) var(--light) var(--dark); }\n.btn.primary { background:#d0e4ff; }\n.hud { margin-left:auto; display:flex; align-items:center; gap:10px; }\n.hud .mono { font-family: \"Lucida Console\", Monaco, monospace; }\n.toolbar { display:flex; align-items:center; gap:6px; padding:4px; }\n.namebox { width:70px; }\n.formulalabel { padding:0 4px; }\n.formulabar { flex:1; min-width:0; }\n.formulabar input { width:100%; border:none; outline:none; padding:2px 4px; font-family: \"Lucida Console\", Monaco, monospace; background:#fff; }\n#gridWrap { flex:1; min-height:0; margin:4px; display:flex; flex-direction:column; }\n.sheet { width:100%; height:100%; overflow:auto; background:#fff; }\ntable.grid { border-collapse:separate; border-spacing:0; width:100%; }\nthead th { position:sticky; top:0; z-index:3; background:#d4d0c8; border-right:1px solid #a0a0a0; border-bottom:2px solid #a0a0a0; padding:2px 6px; font-weight:normal; user-select:none; white-space:nowrap; }\nthead th.sortable { cursor:pointer; }\nthead th .sort { float:right; color:#555; }\ntbody td, tfoot td { border-right:1px solid #e5e5e5; border-bottom:1px solid #e5e5e5; padding:2px 6px; background:#fff; white-space:nowrap; }\ntbody tr:nth-child(odd) td { background:#fafafa; }\ntbody td.num, tfoot td.num { text-align:right; font-family:\"Lucida Console\", Monaco, monospace; }\ntbody td.pct, tfoot td.pct { text-align:right; font-family:\"Lucida Console\", Monaco, monospace; }\ntbody td.usd, tfoot td.usd { text-align:right; font-family:\"Lucida Console\", Monaco, monospace; }\ntbody td.text, tfoot td.text { text-align:left; }\ntd.rowhdr, th.corner { position:sticky; left:0; z-index:2; background:#d4d0c8; font-family:\"Lucida Console\", Monaco, monospace; border-right:2px solid #a0a0a0; }\nth.corner { top:0; z-index:4; }\ntbody td.sel, thead th.sel { outline:2px solid var(--sel); outline-offset:-2px; background:#ccddff; }\ntbody td.range { background:#e6f0ff; }\ntfoot td { background:#eef2f6; border-top:2px solid #a0a0a0; font-weight:bold; }\n.status { padding:3px 6px; display:flex; align-items:center; gap:10px; }\n.status .hint { margin-left:auto; color:#333; }\n.up { color:#086f00; }\n.down { color:#a40000; }\n.mono { font-family:\"Lucida Console\", Monaco, monospace; }\n.tabbar { display:flex; gap:6px; padding:4px; }\n.tab { padding:2px 10px; background:#e8e8e8; border:2px solid; border-color:var(--light) var(--dark) var(--dark) var(--light); }\n.tab.active { background:#fff; border-color:var(--dark) var(--light) var(--light) var(--dark); }\n.hidden { display:none; }\n\n/* Preview compact scaling */\n.preview #gridWrap { margin:2px; }\n.preview .menubar, .preview .toolbar, .preview .tabbar { display:none; }\n.preview .status .hint { display:none; }\n\n/* Resize friendliness */\n@media (max-width:600px) {\n  .menubar span { margin-right:6px; }\n  .hud { display:none; }\n}\n</style>\n\n<div id=\"excel98\" class=\"raised\">\n  <div id=\"titlebar\" class=\"title\">Microsoft Excel — loading…</div>\n  <div class=\"menubar\">\n    <span>File</span><span>Edit</span><span>View</span><span>Insert</span><span>Format</span><span>Tools</span><span>Data</span><span>Window</span><span>Help</span>\n    <div id=\"actions\" class=\"hud\"></div>\n  </div>\n  <div class=\"toolbar raised\">\n    <input id=\"nameBox\" class=\"sunken namebox mono\" value=\"A1\" readonly />\n    <div class=\"formulalabel\">fx</div>\n    <div class=\"sunken formulabar\"><input id=\"formula\" value=\"\" readonly></div>\n  </div>\n  <div id=\"gridWrap\" class=\"sunken\">\n    <div id=\"sheetView\" class=\"sheet\">\n      <table id=\"grid\" class=\"grid mono\">\n        <thead><tr id=\"theadRow\"></tr></thead>\n        <tbody id=\"tbody\"></tbody>\n        <tfoot id=\"tfoot\"></tfoot>\n      </table>\n    </div>\n  </div>\n  <div class=\"tabbar\"><div class=\"tab active\">Sheet1</div></div>\n  <div class=\"status raised\">\n    <div id=\"hudTitle\" class=\"mono\">—</div>\n    <div id=\"hudNumber\" class=\"mono\">—</div>\n    <div class=\"hint\">Arrows: move • Enter: sort • Click: select • H: headers</div>\n  </div>\n</div>\n\n<script>\n(function(){\n  const els = {\n    root: document.getElementById('excel98'),\n    title: document.getElementById('titlebar'),\n    actions: document.getElementById('actions'),\n    thead: document.getElementById('theadRow'),\n    tbody: document.getElementById('tbody'),\n    tfoot: document.getElementById('tfoot'),\n    nameBox: document.getElementById('nameBox'),\n    formula: document.getElementById('formula'),\n    sheet: document.getElementById('grid'),\n    sheetView: document.getElementById('sheetView'),\n    hudTitle: document.getElementById('hudTitle'),\n    hudNumber: document.getElementById('hudNumber'),\n    gridWrap: document.getElementById('gridWrap')\n  };\n\n  let state = {\n    app: {},\n    bundle: {},\n    columns: [],    // [{key,label,fmt,align}]\n    rows: [],       // array of row objects {key: value}\n    footer: null,   // object or null\n    sortedKey: null,\n    sortDir: 1,     // 1 asc, -1 desc\n    sel: {r:0,c:0, r2:0,c2:0},\n    readyCalled: false,\n    preview: false,\n    attractTimer: 0\n  };\n\n  function classOfFmt(fmt) {\n    if (fmt === 'usd') return 'usd';\n    if (fmt === 'pct') return 'pct';\n    if (fmt === 'num') return 'num';\n    return 'text';\n  }\n  function isNumericFmt(fmt) {\n    return fmt === 'usd' || fmt === 'pct' || fmt === 'num';\n  }\n  function fmtNum(n) {\n    if (typeof n !== 'number' || !isFinite(n)) return '';\n    const abs = Math.abs(n);\n    const dec = abs >= 1000 ? 2 : (abs >= 1 ? 4 : 8);\n    return n.toLocaleString('en-US', {maximumFractionDigits: dec});\n  }\n  function formatCell(fmt, v) {\n    if (v == null) return '';\n    if (fmt === 'usd') {\n      const num = (typeof v === 'number') ? v : Number(v);\n      if (isFinite(num)) return suica.fmt.usd(num);\n      return String(v);\n    }\n    if (fmt === 'pct') {\n      const num = (typeof v === 'number') ? v : Number(v);\n      if (isFinite(num)) return suica.fmt.pct(num);\n      return String(v);\n    }\n    if (fmt === 'num') return fmtNum(v);\n    return String(v);\n  }\n  function cellSortKey(fmt, v) {\n    if (v == null) return -Infinity;\n    if (isNumericFmt(fmt) && typeof v === 'number') return v;\n    if (isNumericFmt(fmt) && typeof v !== 'number') {\n      const n = Number(v);\n      return isFinite(n) ? n : -Infinity;\n    }\n    return String(v).toLowerCase();\n  }\n  function toColLetter(idx) {\n    let s = '';\n    let n = idx + 1;\n    while (n > 0) {\n      const m = (n - 1) % 26;\n      s = String.fromCharCode(65 + m) + s;\n      n = Math.floor((n - 1) / 26);\n    }\n    return s;\n  }\n  function findBestNumber(bundle) {\n    try {\n      if (bundle && bundle.table && bundle.table.total) {\n        if (typeof bundle.table.total.value === 'number') return suica.fmt.usd(bundle.table.total.value);\n        const usdCol = (bundle.table.columns||[]).find(c => c.fmt === 'usd');\n        if (usdCol && typeof bundle.table.total[usdCol.key] === 'number') return suica.fmt.usd(bundle.table.total[usdCol.key]);\n      }\n      if (bundle && bundle.series && Array.isArray(bundle.series.points) && bundle.series.points.length) {\n        const last = bundle.series.points[bundle.series.points.length-1];\n        if (bundle.series.unit === 'usd') return suica.fmt.usd(last);\n        if (bundle.series.unit === 'pct') return suica.fmt.pct(last);\n        return fmtNum(last);\n      }\n      if (bundle && bundle.gauge && typeof bundle.gauge.value === 'number') {\n        const pct = Math.round(bundle.gauge.value * 10000) / 100;\n        return pct.toFixed(2) + '%';\n      }\n      if (bundle && bundle.list && bundle.list.items && bundle.list.items.length && bundle.list.items[0].right) {\n        return String(bundle.list.items[0].right);\n      }\n    } catch(e){}\n    return '—';\n  }\n\n  function extractSheetData(bundle) {\n    const data = { columns: [], rows: [], footer: null };\n    if (bundle && bundle.table && Array.isArray(bundle.table.columns) && Array.isArray(bundle.table.rows)) {\n      data.columns = bundle.table.columns.map(c => ({\n        key: c.key, label: c.label, fmt: c.fmt || 'text', align: isNumericFmt(c.fmt||'text') ? 'right' : 'left'\n      }));\n      data.rows = bundle.table.rows.slice();\n      data.footer = bundle.table.total || null;\n      return data;\n    }\n    if (bundle && bundle.list && bundle.list.items) {\n      data.columns = [\n        {key:'title', label:'Title', fmt:'text'},\n        {key:'subtitle', label:'Subtitle', fmt:'text'},\n        {key:'right', label:'Right', fmt:'text'},\n        {key:'tone', label:'Tone', fmt:'text'}\n      ];\n      data.rows = bundle.list.items.map(it => ({\n        title: it.title || '',\n        subtitle: it.subtitle || '',\n        right: it.right || '',\n        tone: it.tone || ''\n      }));\n      return data;\n    }\n    if (bundle && bundle.grid && bundle.grid.cells && Array.isArray(bundle.grid.cells)) {\n      data.columns = [\n        {key:'cell', label:'Cell', fmt:'text'},\n        {key:'label', label:'Label', fmt:'text'},\n        {key:'risk', label:'Risk', fmt:'pct'},\n        {key:'mine', label:'Mine', fmt:'text'}\n      ];\n      const rows = [];\n      for (let r=0;r<bundle.grid.cells.length;r++){\n        const row = bundle.grid.cells[r];\n        for (let c=0;c<row.length;c++){\n          const cell = row[c];\n          rows.push({\n            cell: toColLetter(c) + (r+1),\n            label: cell.label || '',\n            risk: typeof cell.risk === 'number' ? (cell.risk*100) : null,\n            mine: cell.mine ? 'yes' : 'no'\n          });\n        }\n      }\n      data.rows = rows;\n      return data;\n    }\n    if (bundle && bundle.gauge) {\n      data.columns = [\n        {key:'label', label:'Label', fmt:'text'},\n        {key:'value', label:'Value', fmt:'pct'},\n        {key:'caption', label:'Caption', fmt:'text'}\n      ];\n      const pct = typeof bundle.gauge.value === 'number' ? (bundle.gauge.value*100) : null;\n      data.rows = [{ label: bundle.gauge.label || '', value: pct, caption: bundle.gauge.caption || '' }];\n      return data;\n    }\n    if (bundle && bundle.scene) {\n      data.columns = [\n        {key:'label', label:'Label', fmt:'text'},\n        {key:'value', label:'Value', fmt:'text'}\n      ];\n      const rows = [];\n      if (bundle.scene.headline) rows.push({label:'Headline', value: bundle.scene.headline});\n      if (bundle.scene.verdict) rows.push({label:'Verdict', value: bundle.scene.verdict});\n      if (Array.isArray(bundle.scene.lines)) {\n        bundle.scene.lines.forEach((ln,i)=>rows.push({label:'Line '+(i+1), value: ln}));\n      }\n      if (Array.isArray(bundle.scene.stats)) {\n        bundle.scene.stats.forEach(s=>rows.push({label:s.label, value:s.value}));\n      }\n      data.rows = rows;\n      return data;\n    }\n    if (bundle && bundle.series) {\n      const pts = Array.isArray(bundle.series.points) ? bundle.series.points : [];\n      const unit = bundle.series.unit || 'text';\n      const cols = [{key:'label', label:(bundle.series.label||'Series'), fmt:'text'}];\n      pts.forEach((_,i)=>cols.push({key:'p'+i, label:(i===pts.length-1?'Now':('t'+i)), fmt: unit==='usd'?'usd':(unit==='pct'?'pct':'num')}));\n      data.columns = cols;\n      const row = { label: bundle.series.label || 'Series' };\n      pts.forEach((v,i)=> row['p'+i] = v);\n      data.rows = [row];\n      return data;\n    }\n    // Empty friendly\n    data.columns = [{key:'note', label:'No data yet', fmt:'text'}];\n    data.rows = [];\n    return data;\n  }\n\n  function buildHeader() {\n    const tr = document.createElement('tr');\n    // Corner\n    const corner = document.createElement('th');\n    corner.className = 'corner';\n    corner.textContent = ' ';\n    tr.appendChild(corner);\n    state.columns.forEach((col, idx) => {\n      const th = document.createElement('th');\n      th.dataset.key = col.key;\n      th.dataset.idx = String(idx);\n      th.className = 'sortable';\n      const label = document.createElement('span');\n      label.textContent = toColLetter(idx) + ': ' + (col.label || col.key);\n      const sort = document.createElement('span');\n      sort.className = 'sort';\n      sort.textContent = (state.sortedKey === col.key) ? (state.sortDir>0?'▲':'▼') : '';\n      th.appendChild(label);\n      th.appendChild(sort);\n      th.addEventListener('click', () => {\n        if (state.preview) return;\n        if (state.sortedKey === col.key) state.sortDir *= -1;\n        else { state.sortedKey = col.key; state.sortDir = 1; }\n        renderBody();\n      });\n      tr.appendChild(th);\n    });\n    els.thead.innerHTML = '';\n    els.thead.appendChild(tr);\n  }\n\n  function renderBody() {\n    // Prepare rows with sorting\n    let rows = state.rows.slice();\n    if (state.sortedKey) {\n      const col = state.columns.find(c=>c.key===state.sortedKey);\n      if (col) {\n        rows.sort((a,b)=>{\n          const av = cellSortKey(col.fmt||'text', a[col.key]);\n          const bv = cellSortKey(col.fmt||'text', b[col.key]);\n          if (av < bv) return -1*state.sortDir;\n          if (av > bv) return 1*state.sortDir;\n          return 0;\n        });\n      }\n    }\n    els.tbody.innerHTML = '';\n    const frag = document.createDocumentFragment();\n    rows.forEach((row, rIdx) => {\n      const tr = document.createElement('tr');\n      // Row header\n      const rh = document.createElement('td');\n      rh.className = 'rowhdr';\n      rh.textContent = String(rIdx+1);\n      tr.appendChild(rh);\n      state.columns.forEach((col, cIdx) => {\n        const td = document.createElement('td');\n        const fmt = col.fmt || 'text';\n        td.className = classOfFmt(fmt);\n        const val = row[col.key];\n        td.textContent = formatCell(fmt, val);\n        if (fmt==='pct') {\n          if (typeof val === 'number') {\n            if (val>0) td.classList.add('up');\n            if (val<0) td.classList.add('down');\n          }\n        }\n        td.dataset.r = String(rIdx);\n        td.dataset.c = String(cIdx);\n        td.addEventListener('click', (e) => {\n          if (state.preview) return;\n          const r = Number(td.dataset.r), c = Number(td.dataset.c);\n          setSelection(r, c);\n        });\n        tr.appendChild(td);\n      });\n      frag.appendChild(tr);\n    });\n    els.tbody.appendChild(frag);\n\n    // Footer (total) for table only\n    els.tfoot.innerHTML = '';\n    if (state.footer && state.columns.length) {\n      const tr = document.createElement('tr');\n      const td0 = document.createElement('td');\n      td0.className = 'rowhdr';\n      td0.textContent = 'Σ';\n      tr.appendChild(td0);\n      state.columns.forEach((col, cIdx) => {\n        const td = document.createElement('td');\n        td.className = classOfFmt(col.fmt||'text');\n        const v = state.footer[col.key];\n        td.textContent = v!=null ? formatCell(col.fmt||'text', v) : '';\n        tr.appendChild(td);\n      });\n      els.tfoot.appendChild(tr);\n    }\n\n    // Update header sort arrows\n    const ths = els.thead.querySelectorAll('th.sortable .sort');\n    ths.forEach(el => {\n      const th = el.parentElement;\n      const k = th ? th.getAttribute('data-key') : null;\n      el.textContent = (k && k===state.sortedKey) ? (state.sortDir>0?'▲':'▼') : '';\n    });\n\n    // Refresh selection highlight\n    paintSelection();\n  }\n\n  function setSelection(r, c) {\n    r = Math.max(0, Math.min(r, els.tbody.rows.length - 1));\n    c = Math.max(0, Math.min(c, state.columns.length - 1));\n    state.sel = { r, c, r2:r, c2:c };\n    paintSelection();\n    updateFormulaBar();\n  }\n\n  function paintSelection() {\n    // Clear all\n    els.tbody.querySelectorAll('td.sel, td.range').forEach(td => td.classList.remove('sel','range'));\n    // Paint\n    const { r, c, r2, c2 } = state.sel;\n    if (els.tbody.rows.length===0 || state.columns.length===0) return;\n    const rMin = Math.min(r,r2), rMax = Math.max(r,r2);\n    const cMin = Math.min(c,c2), cMax = Math.max(c,c2);\n    for (let i=rMin;i<=rMax;i++){\n      const tr = els.tbody.rows[i];\n      if (!tr) continue;\n      for (let j=cMin;j<=cMax;j++){\n        const td = tr.cells[j+1]; // +1 for row header\n        if (!td) continue;\n        if (i===r && j===c) td.classList.add('sel');\n        else td.classList.add('range');\n      }\n    }\n    els.nameBox.value = toColLetter(c) + (r+1);\n  }\n\n  function updateFormulaBar() {\n    const { r, c } = state.sel;\n    const tr = els.tbody.rows[r];\n    if (!tr) { els.formula.value=''; return; }\n    const td = tr.cells[c+1];\n    els.formula.value = td ? td.textContent || '' : '';\n  }\n\n  function onKey(e) {\n    if (state.preview) return;\n    if (els.tbody.rows.length===0 || state.columns.length===0) return;\n    const sel = Object.assign({}, state.sel);\n    const maxR = els.tbody.rows.length-1;\n    const maxC = state.columns.length-1;\n    let handled = true;\n    const shift = e.shiftKey;\n    if (e.key === 'ArrowDown') { if (sel.r < maxR) sel.r++; }\n    else if (e.key === 'ArrowUp') { if (sel.r > 0) sel.r--; }\n    else if (e.key === 'ArrowRight') { if (sel.c < maxC) sel.c++; }\n    else if (e.key === 'ArrowLeft') { if (sel.c > 0) sel.c--; }\n    else if (e.key === 'Home') { sel.c = 0; }\n    else if (e.key === 'End') { sel.c = maxC; }\n    else if (e.key === 'PageDown') { sel.r = Math.min(maxR, sel.r + 15); }\n    else if (e.key === 'PageUp') { sel.r = Math.max(0, sel.r - 15); }\n    else if (e.key.toLowerCase() === 'h') { // jump to headers – toggle sort column selection\n      const ths = els.thead.querySelectorAll('th.sortable');\n      const idx = Math.max(0, Math.min(sel.c, ths.length-1));\n      ths[idx].click();\n    }\n    else if (e.key === 'Enter') {\n      // Toggle sort on current column\n      const col = state.columns[sel.c];\n      if (col) {\n        if (state.sortedKey === col.key) state.sortDir *= -1;\n        else { state.sortedKey = col.key; state.sortDir = 1; }\n        renderBody();\n      }\n    } else handled = false;\n\n    if (handled) {\n      if (shift) { state.sel.r2 = sel.r; state.sel.c2 = sel.c; }\n      else { state.sel = { r: sel.r, c: sel.c, r2: sel.r, c2: sel.c }; }\n      paintSelection();\n      updateFormulaBar();\n      ensureCellVisible(state.sel.r, state.sel.c);\n      e.preventDefault();\n    }\n  }\n\n  function ensureCellVisible(r, c) {\n    const tr = els.tbody.rows[r];\n    if (!tr) return;\n    const td = tr.cells[c+1];\n    if (!td) return;\n    const rect = td.getBoundingClientRect();\n    const host = els.sheetView.getBoundingClientRect();\n    const dyTop = rect.top - host.top;\n    const dyBottom = rect.bottom - host.bottom;\n    const dxLeft = rect.left - host.left;\n    const dxRight = rect.right - host.right;\n    const sc = els.sheetView;\n    if (dyTop < 0) sc.scrollTop += dyTop;\n    if (dyBottom > 0) sc.scrollTop += dyBottom;\n    if (dxLeft < 0) sc.scrollLeft += dxLeft;\n    if (dxRight > 0) sc.scrollLeft += dxRight;\n  }\n\n  function renderActions(bundle) {\n    els.actions.innerHTML = '';\n    const hudNum = document.createElement('div');\n    hudNum.textContent = findBestNumber(bundle);\n    hudNum.className = 'mono';\n    els.actions.appendChild(hudNum);\n    if (bundle && Array.isArray(bundle.actions) && bundle.actions.length) {\n      bundle.actions.forEach((a, i) => {\n        const b = document.createElement('button');\n        b.className = 'btn' + (a.primary ? ' primary' : '');\n        b.textContent = a.label || 'Action';\n        b.addEventListener('click', () => { if (!state.preview) suica.propose(a.id); });\n        els.actions.appendChild(b);\n      });\n    }\n  }\n\n  function renderAll() {\n    // Title + HUD\n    const appTitle = (state.bundle && state.bundle.title) ? state.bundle.title : (state.app && state.app.title) ? state.app.title : '—';\n    els.title.textContent = 'Microsoft Excel — ' + appTitle;\n    els.hudTitle.textContent = appTitle;\n    els.hudNumber.textContent = findBestNumber(state.bundle);\n\n    // Build header/body\n    buildHeader();\n    renderBody();\n    renderActions(state.bundle);\n\n    // Initial selection\n    if (els.tbody.rows.length>0 && state.columns.length>0) {\n      if (state.sel.r >= els.tbody.rows.length) state.sel.r = 0;\n      if (state.sel.c >= state.columns.length) state.sel.c = 0;\n      setSelection(state.sel.r, state.sel.c);\n    } else {\n      els.formula.value = '';\n      els.nameBox.value = '';\n    }\n  }\n\n  function setPreviewMode(isPreview) {\n    state.preview = !!isPreview;\n    els.root.classList.toggle('preview', state.preview);\n    clearInterval(state.attractTimer);\n    if (state.preview) {\n      // Attract mode: rotate sort across columns\n      let idx = 0, dir = 1;\n      state.attractTimer = setInterval(()=>{\n        if (!state.columns.length) return;\n        state.sortedKey = state.columns[idx].key;\n        state.sortDir = dir;\n        dir = -dir;\n        idx = (idx + 1) % state.columns.length;\n        renderBody();\n      }, 1400);\n    }\n  }\n\n  // Focus handling\n  els.gridWrap.tabIndex = 0;\n  els.gridWrap.addEventListener('keydown', onKey);\n  els.gridWrap.addEventListener('mousedown', () => { if(!state.preview) els.gridWrap.focus(); });\n\n  // Data binding\n  suica.onData(({ bundle, app }) => {\n    state.app = app || {};\n    state.bundle = bundle || {};\n    setPreviewMode(!!(app && app.preview));\n    const data = extractSheetData(state.bundle || {});\n    state.columns = data.columns || [];\n    state.rows = data.rows || [];\n    state.footer = data.footer || null;\n    // pick a default sort: value/first usd col if present in table\n    if (!state.sortedKey) {\n      if (state.bundle && state.bundle.table) {\n        const cols = state.bundle.table.columns || [];\n        const vcol = cols.find(c => c.key==='value') || cols.find(c => c.fmt==='usd');\n        state.sortedKey = vcol ? vcol.key : (state.columns[0] ? state.columns[0].key : null);\n        state.sortDir = vcol ? -1 : 1;\n      } else {\n        state.sortedKey = state.columns[0] ? state.columns[0].key : null;\n        state.sortDir = 1;\n      }\n    }\n    renderAll();\n\n    if (!state.readyCalled) {\n      state.readyCalled = true;\n      requestAnimationFrame(()=>{ try { suica.ready(); } catch(e){} });\n    }\n  });\n\n})();\n</script>","blobId":"gEI6FuTXtU_E3lRP6XXkVhDZ8CUOcgXoPMZ2cgkhHwo","ens":"excel-sheet.shells.suica.eth"}