# Jev: the OpenAI Decisions API (POST /v1/decisions) composes every app's UI as you type.
# Leave empty to run fully offline with the keyword classifier.
OPENAI_API_KEY=
# Optional: model override (default gpt-6-luna)
JEV_MODEL=
# Force offline mode even with a key (UI work, demos on flaky wifi)
NEXT_PUBLIC_USE_MOCK=false

# Gemini: writes each app's starting data, and draws pictures inside apps
GEMINI_API_KEY=
# App content (text) model, default gemini-3.5-flash-lite
# GEMINI_CONTENT_MODEL=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Spending limits, enforced by the app itself (in memory: exact on one server, per instance on serverless).
# Past the daily limit (UTC day) Jev falls back offline and data/pictures say "try again tomorrow".
SPEND_LIMIT_USD_PER_DAY=5
# All-visitors hourly caps (per-visitor limits also apply: compose 120/min, data 30/min, pictures 12/min)
GLOBAL_COMPOSE_PER_HOUR=3000
GLOBAL_CONTENT_PER_HOUR=600
GLOBAL_IMAGE_PER_HOUR=100
# Prices used to estimate spend (USD)
# DECISIONS_USD_PER_M_INPUT=0.10
# GEMINI_USD_PER_M_INPUT=0.10
# GEMINI_USD_PER_M_OUTPUT=0.40
# GEMINI_USD_PER_IMAGE=0.04
