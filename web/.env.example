# Jev (TypeSafe AI) via Vercel AI Gateway — https://vercel.com/docs/ai-gateway/sdks-and-apis/typesafe
# Leave empty to run fully offline with the keyword classifier.
AI_GATEWAY_API_KEY=
# Optional: model override (gateway default: typesafe-ai/jev)
JEV_MODEL=
# Optional fallback: call TypeSafe directly instead of through the gateway
TYPESAFE_API_KEY=
# Force offline mode even with a key (UI work, demos on flaky wifi)
NEXT_PUBLIC_USE_MOCK=false

# ── ENS (Sepolia) — server wallet that owns suica.eth and mints apps/folders. Never commit real values.
SEPOLIA_PRIVATE_KEY=
SEPOLIA_ADDRESS=
# Optional: your own Sepolia RPC (default: publicnode)
SEPOLIA_RPC_URL=
NEXT_PUBLIC_ENS_ROOT=suica.eth

# ── Sui (testnet)
# Enoki private key (server-only): zkLogin proofs + sponsored transactions
ENOKI_PRIVATE_KEY=
NEXT_PUBLIC_SUI_NETWORK=testnet
# Google OAuth client id (public; zkLogin uses the implicit id_token flow, no client secret needed)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Sui server wallet (tops up users, publishes Move packages, runs agent executor)
SUI_PRIVATE_KEY=
SUI_ADDRESS=
