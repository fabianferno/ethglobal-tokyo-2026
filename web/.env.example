# Jev (TypeSafe AI) via Vercel AI Gateway — https://vercel.com/docs/ai-gateway/sdks-and-apis/typesafe
# Leave empty to run fully offline with the keyword classifier.
AI_GATEWAY_API_KEY=
# Optional: model override (gateway default: typesafe-ai/jev)
JEV_MODEL=
# Optional fallback: call TypeSafe directly instead of through the gateway
TYPESAFE_API_KEY=
# Force offline mode even with a key (UI work, demos on flaky wifi)
NEXT_PUBLIC_USE_MOCK=false
