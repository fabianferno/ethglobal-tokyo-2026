# Jev (TypeSafe AI) via Vercel AI Gateway — https://vercel.com/docs/ai-gateway/sdks-and-apis/typesafe
# Composes every app's UI as you type. Needs paid gateway credits (the free tier blocks typesafe-ai/jev).
# Leave empty to run fully offline with the keyword classifier.
AI_GATEWAY_API_KEY=
# Optional: model override (gateway default: typesafe-ai/jev)
JEV_MODEL=
# Optional fallback: call TypeSafe directly instead of through the gateway
TYPESAFE_API_KEY=
# Force offline mode even with a key (UI work, demos on flaky wifi)
NEXT_PUBLIC_USE_MOCK=false

# Generated programs ("tetris but …"), written once via the gateway. Tried in order.
GENSHELL_MODELS=anthropic/claude-sonnet-5,openai/gpt-5

# Gemini: writes each app's content, and draws pictures inside apps
GEMINI_API_KEY=
# App content (text) model, default gemini-3.5-flash-lite
# GEMINI_CONTENT_MODEL=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
